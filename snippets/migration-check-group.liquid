{% comment %}
  One "before / after" block of the migration check: the old product on the
  first row, the products it became on the second, both drawn with card-product.

  Accepts:
  - old_handle: {String} handle of the product that was split (required)
  - kids: {Array} handles of the products it became (required)
  - flag: {String} precomputed marker from the handle map (ok / noimgN / nohexN)
  - section: {Object} the calling section, for card display settings
{% endcomment %}

{%- assign old_product = all_products[old_handle] -%}

<div class="migration-check__group{% if flag != 'ok' %} migration-check__group--warn{% endif %}">
  <div class="migration-check__row migration-check__row--old">
    <div class="migration-check__label">
      <span class="migration-check__badge migration-check__badge--old">Было</span>
      <span class="migration-check__handle">{{ old_handle }}</span>
      {%- if old_product != empty and old_product.id != blank -%}
        <span class="migration-check__meta">
          {{ old_product.variants.size }} вариант(ов) · {{ old_product.media.size }} фото
        </span>
      {%- endif -%}
    </div>
    <div class="migration-check__cards migration-check__cards--single">
      {%- if old_product == empty or old_product.id == blank -%}
        <div class="migration-check__missing">
          <strong>{{ old_handle }}</strong>
          <span>старый товар не найден — возможно, уже удалён</span>
        </div>
      {%- else -%}
        {% render 'card-product',
          card_product: old_product,
          media_aspect_ratio: section.settings.image_ratio,
          show_badges: section.settings.show_badges,
          show_wishlist: section.settings.show_wishlist,
          show_swatches: false,
          quick_add: 'none',
          section_id: section.id,
          skip_styles: true
        %}
      {%- endif -%}
    </div>
  </div>

  <div class="migration-check__row migration-check__row--new">
    <div class="migration-check__label">
      <span class="migration-check__badge migration-check__badge--new">Стало</span>
      <span class="migration-check__meta">ожидается {{ kids.size }}</span>
    </div>
    <div class="migration-check__cards">
      {%- liquid
        assign found = 0
        assign missing_images = 0
        assign missing_hex = 0
      -%}
      {%- for kid_handle in kids -%}
        {%- liquid
          assign clean = kid_handle | strip
          if clean == ''
            continue
          endif
          assign child = all_products[clean]
        -%}
        {%- if child == empty or child.id == blank -%}
          <div class="migration-check__missing">
            <strong>{{ clean }}</strong>
            <span>не импортирован</span>
          </div>
          {%- continue -%}
        {%- endif -%}
        {%- liquid
          assign found = found | plus: 1
          if child.media.size == 0
            assign missing_images = missing_images | plus: 1
          endif
          assign child_hex = child.metafields.custom.color.value | default: child.metafields.custom.color | default: '' | strip
          if child_hex == ''
            assign missing_hex = missing_hex | plus: 1
          endif
        -%}
        {%- render 'migration-check-card', child: child, section: section -%}
      {%- endfor -%}
    </div>
  </div>

  {%- liquid
    assign summary_class = 'migration-check__summary'
    if found != kids.size or missing_images > 0 or missing_hex > 0
      assign summary_class = summary_class | append: ' migration-check__summary--warn'
    endif
  -%}
  <p class="{{ summary_class }}">
    Товаров найдено: <strong>{{ found }}</strong> из <strong>{{ kids.size }}</strong>
    {%- if missing_images > 0 %} · без фото: <strong>{{ missing_images }}</strong>{% endif -%}
    {%- if missing_hex > 0 %} · без цвета: <strong>{{ missing_hex }}</strong>{% endif -%}
    {%- if found == kids.size and missing_images == 0 and missing_hex == 0 %} · всё на месте{% endif -%}
  </p>
</div>
