{% comment %}
  Renders one image from the per-variant custom gallery
  (variant metafield custom.gallery, list of files) inside the main
  product media gallery. Mirrors the image branch of product-thumbnail,
  including the modal-opener, so zoom works through the standard
  product-modal mechanism.

  Accepts:
  - file: {Object} image from the file list metafield
  - file_key: {String} stable id used in data-media-id (matches the modal img)
  - media_count, position, media_width, media_fit, constrain_to_viewport,
    modal_id, desktop_layout, mobile_layout, lazy_load - same as product-thumbnail
{% endcomment %}

{%- liquid
  unless lazy_load == false
    assign lazy = 'lazy'
  endunless

  assign desktop_columns = 1
  if desktop_layout == 'columns' and media_count > 1
    assign desktop_columns = 2
  endif

  assign mobile_columns = 1
  if mobile_layout == 'columns' and media_count > 1
    assign mobile_columns = 2
  endif

  assign image_class = 'image-magnify-' | append: section.settings.image_zoom
  assign file_ratio = file.aspect_ratio | default: file.preview_image.aspect_ratio | default: 1.0
-%}

{%- capture sizes -%}
  (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | times: media_width | divided_by: desktop_columns | round }}px, (min-width: 990px) calc({{ media_width | times: 100 | divided_by: desktop_columns }}vw - 10rem), (min-width: 750px) calc((100vw - 11.5rem) / 2), calc(100vw / {{ mobile_columns }} - 4rem)
{%- endcapture -%}

<div
  class="product-media-container media-type-image media-fit-{{ media_fit }} global-media-settings gradient{% if constrain_to_viewport %} constrain-height{% endif %}"
  style="--ratio: {{ file_ratio }}; --preview-ratio: {{ file_ratio }};"
>
  <modal-opener
    class="product__modal-opener product__modal-opener--image"
    data-modal="#ProductModal-{{ modal_id }}"
  >
    <span
      class="product__media-icon motion-reduce quick-add-hidden product__media-icon--{{ section.settings.image_zoom }}"
      aria-hidden="true"
    >
      <span class="svg-wrapper">
        {{- 'icon-zoom.svg' | inline_asset_content -}}
      </span>
    </span>
    {%- render 'loading-spinner' -%}
    <div class="product__media media media--transparent">
      {{
        file
        | image_url: width: 1946
        | image_tag:
          class: image_class,
          loading: lazy,
          sizes: sizes,
          widths: '246, 493, 600, 713, 823, 990, 1100, 1206, 1346, 1426, 1646, 1946'
      }}
    </div>
    <button
      class="product__media-toggle quick-add-hidden product__media-zoom-{{ section.settings.image_zoom }}"
      type="button"
      aria-haspopup="dialog"
      data-media-id="{{ file_key }}"
    >
      <span class="visually-hidden">
        {{ 'products.product.media.open_media' | t: index: position }}
      </span>
    </button>
  </modal-opener>
</div>
