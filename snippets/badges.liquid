{%- comment -%}
  Бейджи товара — единственный источник бейджей для карточки товара и для галереи
  на странице товара.

  Что выводит:
    1. Штатные бейджи темы, независимые друг от друга:
       «нет в наличии» (левый верхний, глушит остальные штатные),
       «вернулся в продажу» (левый верхний),
       SALE (левый верхний) + «N% OFF» (левый нижний) для уценённых товаров.
    2. Пользовательские бейджи из метаобъектов custom.megaobjects_badges
       (метаполе товара + метаполя всех его коллекций).
       Угол каждого берётся из поля метаобъекта `position`
       со значениями: top left / top right / bottom left / bottom right / under-image.
       Если поле пустое или заполнено чем-то другим — бейдж уходит в левый верхний угол.

  Дубли по badge_name убираются на уровне Liquid. Раньше это делал <style>-хак
  с соседним селектором `~`, который при выводе бейджей в разные углы перестаёт
  работать в принципе (у бейджей больше нет общего родителя).

  Параметры:
    card_product - товар (обязательно)
    section_id   - id секции, для уникальных id элементов (необязательно)
    badge_id     - префикс id штатного бейджа, по умолчанию 'Badge' (необязательно)
    only         - если 'under-image', рисуются ТОЛЬКО бейджи с position = under-image,
                   обычным блоком в потоке (на карточке — над заголовком,
                   на странице товара — над h1). Без этого параметра рисуются
                   четыре угла и штатные бейджи темы, а under-image пропускается.

  Позиционирование углов — .card__badges--* в assets/base.css.
  Якорем служит ближайший position: relative предок:
  .card__inner.ratio / .card__content на карточке, slider-component в галерее.
{%- endcomment -%}

{%- liquid
  assign badge_product = card_product | default: product
  assign badge_id_prefix = badge_id | default: 'Badge'

  # Все допустимые значения поля position в метаобъекте.
  # 'under image' — не угол: такой бейдж рисуется в потоке, отдельным вызовом сниппета.
  assign allowed_positions = 'top left,top right,bottom left,bottom right,under image' | split: ','

  # Угол по умолчанию: сюда попадают штатные бейджи темы и все метаобъекты,
  # у которых поле position не заполнено.
  # Если когда-нибудь захочется брать его из настроек темы —
  # заменить строку ниже на: assign default_position = settings.badge_position
  assign default_position = 'top left'

  assign default_position = default_position | default: 'top left' | downcase | strip | replace: '-', ' ' | replace: '_', ' '
  unless allowed_positions contains default_position
    assign default_position = 'top left'
  endunless

  # Что рисует этот конкретный вызов:
  #   only: 'under-image' — только бейджи под изображением (блок в потоке, без absolute);
  #   без only            — четыре угла поверх картинки плюс штатные бейджи темы.
  assign only_position = only | default: '' | downcase | strip | replace: '-', ' ' | replace: '_', ' '
  if only_position != blank
    assign render_positions = only_position | split: '~'
  else
    assign render_positions = 'top left,top right,bottom left,bottom right' | split: ','
  endif

  # нормализуем теги: убираем регистр, дефисы, подчёркивания и пробелы
  assign tag_string = badge_product.tags | join: '|' | downcase | replace: '-', '' | replace: '_', '' | replace: ' ', ''

  assign is_back_in_stock = false
  if tag_string contains 'backinstock'
    assign is_back_in_stock = true
  elsif tag_string contains 'restock'
    assign is_back_in_stock = true
  elsif tag_string contains 'backinstore'
    assign is_back_in_stock = true
  endif

  # скидка: сначала по выбранному варианту, если он не уценён — по товару целиком
  assign badge_variant = badge_product.selected_or_first_available_variant
  assign badge_price = badge_variant.price | default: badge_product.price
  assign badge_compare = badge_variant.compare_at_price | default: badge_product.compare_at_price
  if badge_compare <= badge_price
    assign badge_price = badge_product.price_min
    assign badge_compare = badge_product.compare_at_price_min
  endif

  assign discount_percent = 0
  if badge_compare > badge_price and badge_compare > 0
    assign discount_percent = badge_compare | minus: badge_price | times: 100 | divided_by: badge_compare
  endif

  assign rendered_names = ''

  # Персональные цвета автоматических бейджей из настроек темы
  # (Theme settings -> Badges -> Automatic badge colors). Пустая настройка —
  # остаётся дефолтная цветовая схема. Инлайн с !important, тем же способом,
  # каким красятся пользовательские бейджи из метаобъектов (badge-item.liquid).
  assign sale_badge_style = ''
  if settings.badge_sale_background != blank
    assign sale_badge_style = sale_badge_style | append: 'background-color: ' | append: settings.badge_sale_background | append: ' !important;'
  endif
  if settings.badge_sale_text != blank
    assign sale_badge_style = sale_badge_style | append: ' color: ' | append: settings.badge_sale_text | append: ' !important;'
  endif

  assign sold_out_badge_style = ''
  if settings.badge_sold_out_background != blank
    assign sold_out_badge_style = sold_out_badge_style | append: 'background-color: ' | append: settings.badge_sold_out_background | append: ' !important;'
  endif
  if settings.badge_sold_out_text != blank
    assign sold_out_badge_style = sold_out_badge_style | append: ' color: ' | append: settings.badge_sold_out_text | append: ' !important;'
  endif

  assign back_in_stock_badge_style = ''
  if settings.badge_back_in_stock_background != blank
    assign back_in_stock_badge_style = back_in_stock_badge_style | append: 'background-color: ' | append: settings.badge_back_in_stock_background | append: ' !important;'
  endif
  if settings.badge_back_in_stock_text != blank
    assign back_in_stock_badge_style = back_in_stock_badge_style | append: ' color: ' | append: settings.badge_back_in_stock_text | append: ' !important;'
  endif
-%}

{%- for corner in render_positions -%}
  {%- assign corner_class = corner | replace: ' ', '-' -%}

  {%- capture corner_content -%}

    {%- comment -%}
      Штатные бейджи темы. Независимы друг от друга:
        - «нет в наличии» — левый верхний; на распроданном товаре SALE и процент
          не показываются (скидка на то, что нельзя купить, — не информация);
        - «вернулся в продажу» — левый верхний, живёт своей жизнью: уценённый
          back-in-stock товар получает и его, и SALE, стопкой;
        - скидка — два бейджа: SALE в левом верхнем, «N% OFF» в левом нижнем.
      Только в «угловом» вызове (без only).
    {%- endcomment -%}
    {%- if only_position == blank -%}
      {%- if corner == 'top left' -%}
        {%- if badge_product.available == false -%}
          <span
            id="{{ badge_id_prefix }}-{{ section_id }}-{{ badge_product.id }}"
            class="badge badge--{{ corner_class }} color-{{ settings.sold_out_badge_color_scheme }}"
            {% if sold_out_badge_style != blank %}style="{{ sold_out_badge_style }}"{% endif %}
          >
            <span>{{- 'products.product.sold_out' | t -}}</span>
          </span>
        {%- else -%}
          {%- if discount_percent > 0 -%}
            <span
              id="{{ badge_id_prefix }}-{{ section_id }}-{{ badge_product.id }}"
              class="badge badge--{{ corner_class }} badge--sale color-{{ settings.sale_badge_color_scheme }}"
              {% if sale_badge_style != blank %}style="{{ sale_badge_style }}"{% endif %}
            >
              <span>{{- 'products.product.on_sale' | t -}}</span>
            </span>
          {%- endif -%}
          {%- if is_back_in_stock -%}
            <span
              id="{{ badge_id_prefix }}-back-in-stock-{{ section_id }}-{{ badge_product.id }}"
              class="badge badge--{{ corner_class }} badge--back-in-stock color-{{ settings.sale_badge_color_scheme }}"
              {% if back_in_stock_badge_style != blank %}style="{{ back_in_stock_badge_style }}"{% endif %}
            >
              <span>Back in stock</span>
            </span>
          {%- endif -%}
        {%- endif -%}
      {%- elsif corner == 'bottom left' -%}
        {%- if badge_product.available and discount_percent > 0 -%}
          <span
            id="{{ badge_id_prefix }}-discount-{{ section_id }}-{{ badge_product.id }}"
            class="badge badge--{{ corner_class }} badge--discount color-{{ settings.sale_badge_color_scheme }}"
            {% if sale_badge_style != blank %}style="{{ sale_badge_style }}"{% endif %}
          >
            <span>{{ discount_percent }}% OFF</span>
          </span>
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}

    {%- comment -%}Пользовательские бейджи из метаполя товара{%- endcomment -%}
    {%- for badge_one in badge_product.metafields.custom.megaobjects_badges.value -%}
      {%- liquid
        assign badge_name = badge_one.badge_name | strip
        assign badge_corner = badge_one.position | default: badge_one.badge_position | default: badge_one.align | default: default_position
        assign badge_corner = badge_corner | downcase | strip | replace: '-', ' ' | replace: '_', ' '
        unless allowed_positions contains badge_corner
          assign badge_corner = default_position
        endunless
        assign name_key = '<<' | append: badge_name | downcase | append: '>>'
      -%}
      {%- if badge_name != blank and badge_corner == corner -%}
        {%- unless rendered_names contains name_key -%}
          {%- assign rendered_names = rendered_names | append: name_key -%}
          {%- render 'badge-item', badge_one: badge_one, badge_name: badge_name, corner_class: corner_class -%}
        {%- endunless -%}
      {%- endif -%}
    {%- endfor -%}

    {%- comment -%}Пользовательские бейджи из метаполей коллекций товара{%- endcomment -%}
    {%- for badge_collection in badge_product.collections -%}
      {%- for badge_one in badge_collection.metafields.custom.megaobjects_badges.value -%}
        {%- liquid
          assign badge_name = badge_one.badge_name | strip
          assign badge_corner = badge_one.position | default: badge_one.badge_position | default: badge_one.align | default: default_position
          assign badge_corner = badge_corner | downcase | strip | replace: '-', ' ' | replace: '_', ' '
          unless allowed_positions contains badge_corner
            assign badge_corner = default_position
          endunless
          assign name_key = '<<' | append: badge_name | downcase | append: '>>'
        -%}
        {%- if badge_name != blank and badge_corner == corner -%}
          {%- unless rendered_names contains name_key -%}
            {%- assign rendered_names = rendered_names | append: name_key -%}
            {%- render 'badge-item', badge_one: badge_one, badge_name: badge_name, corner_class: corner_class -%}
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- assign corner_trimmed = corner_content | strip -%}
  {%- if corner_trimmed != blank -%}
    <div class="card__badge card__badges card__badges--{{ corner_class }}">
      {{- corner_content -}}
    </div>
  {%- endif -%}
{%- endfor -%}
