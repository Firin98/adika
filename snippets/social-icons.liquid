{% comment %}
  Renders social icons.

  A custom icon can be uploaded per network in the theme settings
  (Social media -> "<network> custom icon"). When an image is uploaded it is
  used; otherwise the snippet falls back to the theme default for this file.
  Uploaded icons are sized by the social_icon_width setting.

  Accepts:
  - class: {String} a class to be added to the <ul> element (optional).

  Usage:
  {% render 'social-icons',
    class: 'my-class'
  %}
{% endcomment %}

{%- assign social_icon_height = settings.social_icon_width | default: 22 -%}
{%- comment -%}
  wa.me accepts digits only: international format, no plus sign, spaces,
  dashes or brackets. Merchants type the number however they like, so it is
  normalised here instead of relying on the setting being clean.
{%- endcomment -%}
{%- assign whatsapp_number = settings.social_whatsapp_number
  | remove: '+'
  | remove: ' '
  | remove: '-'
  | remove: '('
  | remove: ')'
  | remove: '.'
  | strip
-%}

<ul class="list-unstyled list-social{% if class %} {{ class}}{% endif %}" role="list">
  {%- if settings.social_facebook_link != blank -%}
    <li class="list-social__item">
      <a href="{{ settings.social_facebook_link }}" class="link list-social__link">
        {%- if settings.social_facebook_icon != blank -%}
          <img
            src="{{ settings.social_facebook_icon | image_url: width: 160 }}"
            alt="{{ 'general.social.links.facebook' | t | escape }}"
            width="{{ settings.social_facebook_icon.width }}"
            height="{{ settings.social_facebook_icon.height }}"
            loading="lazy"
            class="list-social__icon"
            style="height: {{ social_icon_height }}px;"
          >
        {%- else -%}
          <span class="svg-wrapper">
            {{- 'icon-facebook.svg' | inline_asset_content -}}
          </span>
        {%- endif -%}
        <span class="visually-hidden">{{ 'general.social.links.facebook' | t }}</span>
      </a>
    </li>
  {%- endif -%}
