{% comment %}
  Renders social icons.

  Иконку каждой соцсети можно загрузить в настройках темы
  (Social media -> «<сеть> — своя иконка»). Если картинка загружена,
  показывается она; если нет — стандартная иконка/подпись темы.
  Высота своих иконок задаётся настройкой social_icon_width.

  Accepts:
  - class: {String} a class to be added to the <ul> element (optional).

  Usage:
  {% render 'social-icons',
    class: 'my-class'
  %}
{% endcomment %}

{%- assign social_icon_height = settings.social_icon_width | default: 22 -%}

<ul class="list-unstyled list-social{% if class %} {{ class}}{% endif %}" role="list">
  {%- if settings.social_facebook_link != blank -%}
    <li class="list-social__item">
      <a href="{{ settings.social_facebook_link }}" class="link list-social__link">
        {%- if settings.social_facebook_icon != blank -%}
          <img
            src="{{ settings.social_facebook_icon | image_url: width: 160 }}"
            alt="{{ 'general.social.links.facebook' | t | escape }}"
            width="{{ settings.social_facebook_icon.width }}"
            height="{{ settings.social_facebook_icon.height }}"
            loading="lazy"
            class="list-social__icon"
            style="height: {{ social_icon_height }}px;"
          >
        {%- else -%}
          <span class="svg-wrapper">
            {{- 'icon-facebook.svg' | inline_asset_content -}}
          </span>
        {%- endif -%}
        <span class="visually-hidden">{{ 'general.social.links.facebook' | t }}</span>
      </a>
    </li>
  {%- endif -%}
