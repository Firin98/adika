{%- comment -%}
  Разметка одного пользовательского бейджа из метаобъекта.
  Вызывается только из snippets/badges.liquid — вся логика выбора угла,
  дедупликации и фильтрации остаётся там.

  Параметры:
    badge_one    - метаобъект бейджа
    badge_name   - уже подготовленное имя (strip)
    corner_class - top-left / top-right / bottom-left / bottom-right
{%- endcomment -%}
<span
  data-label="{{ badge_name | escape }}"
  style="
    {%- if badge_one.image_label != blank -%}
      padding: 0; background-color: transparent !important;
    {%- else -%}
      {%- if badge_one.text_color != blank %} color: {{ badge_one.text_color | escape }} !important;{% endif -%}
      {%- if badge_one.background_color != blank %} background-color: {{ badge_one.background_color | escape }} !important;{% endif -%}
    {%- endif -%}
    {%- if badge_one.is_ltr == true %} direction: ltr !important;{% endif -%}
  "
  class="badge badge--{{ corner_class }} color-{{ settings.sale_badge_color_scheme }}"
>
  {%- if badge_one.image_label != blank -%}
    <img
      src="{{ badge_one.image_label | image_url: width: 300 }}"
      alt="{{ badge_name | escape }}"
      loading="lazy"
      style="display: block; height: 100%; object-fit: contain; width: {% if badge_one.image_label_width != blank %}{{ badge_one.image_label_width | escape }}{% else %}50{% endif %}px;"
    >
  {%- else -%}
    {{- badge_name -}}
  {%- endif -%}
</span>
