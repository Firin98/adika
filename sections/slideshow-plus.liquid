{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}
{{ 'component-slideshow-plus.css' | asset_url | stylesheet_tag }}

{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

{%- if section.settings.slide_height == 'adapt_image' and section.blocks.first.settings.image != blank -%}
  {%- style -%}
    @media screen and (max-width: 749px) {
      #Slider-{{ section.id }}::before,
      #Slider-{{ section.id }} .media::before,
      #Slider-{{ section.id }}:not(.banner--mobile-bottom) .banner__content::before {
        {% if section.blocks.first.settings.image_mobile != blank and section.blocks.first.settings.image_mobile %}
        padding-bottom: {{ 1 | divided_by: section.blocks.first.settings.image_mobile.aspect_ratio | times: 100 }}%;
        {% else %}
        padding-bottom: {{ 1 | divided_by: section.blocks.first.settings.image.aspect_ratio | times: 100 }}%;
        {% endif %}
        content: '' !important;
        display: block !important;
      }
    }

    @media screen and (min-width: 750px) {
      #Slider-{{ section.id }}::before,
      #Slider-{{ section.id }} .media::before {
        padding-bottom: {{ 1 | divided_by: section.blocks.first.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }
  {%- endstyle -%}
{%- endif -%}
  <style>
    {%- for block in section.blocks -%}
      {% case block.type %}
        {% when 'slide' %}
          {%- if block.settings.video -%}
            #swiper-{{ section.id }} .swiper-wrapper {
              aspect-ratio: 16 / 9;
            }
            @media all and (max-width: 749px) {
              #swiper-{{ section.id }} .swiper-wrapper {
                aspect-ratio: 9 / 16;
              }
            }
          {% else %}
            #swiper-{{ section.id }} .swiper-wrapper {
              aspect-ratio: 16 / 9;
            }
          {% endif %}
        {% when 'video_slide' %}
          #swiper-{{ section.id }} .swiper-wrapper {
            aspect-ratio: 16 / 9;
          }
          @media all and (max-width: 749px) {
            #swiper-{{ section.id }} .swiper-wrapper {
              /* aspect-ratio: 9 / 16;*/
              aspect-ratio: 16 / 9; 

            }
          }
      {% endcase %}
      {% break %}
    {% endfor %}
    
    #swiper-{{ section.id }} .swiper-pagination-bullet {
      background-color: rgba(255,255,255, 0.4);
      margin: 0 5px;
    }
    #swiper-{{ section.id }} .swiper-pagination-bullet-active {
      background-color: #fff;
    }
    .banner__whole-link {
      position: absolute;
      z-index: 3;
      top: 0;
      right: 0;
      left: 0;
      bottom: 0;
      width: 100%;
      height: 100%;
    }
    .template-collection #swiper-{{ section.id }} .swiper-wrapper {
      aspect-ratio: 16 / 9;
    }
  </style>
<div
  class="swiper   slideshow-plus" 
  {% comment %}class="slider-mobile-gutter{% if section.settings.layout == 'grid' %} page-width{% endif %}{% if section.settings.show_text_below %} mobile-text-below{% endif %} {% if section.blocks.first.settings.image == blank and section.blocks.first.settings.video == blank %} hidden{% endif %}"
   {% endcomment %}
  id="swiper-{{ section.id }}"
  role="region"
  aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
  aria-label="{{ section.settings.accessibility_info | escape }}"
>
  {%- if section.settings.auto_rotate and section.blocks.size > 1 -%}
    
  {%- endif -%}

  <div
    class="swiper-wrapper" 
    {% comment %}class="slideshow banner banner--{{ section.settings.slide_height }} grid grid--1-col slider slider--everywhere{% if section.settings.show_text_below %} banner--mobile-bottom{% endif %}{% if section.blocks.first.settings.image == blank %} slideshow--placeholder{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %} {% if section.settings.is_slider_visual_outside %} banner--navigation-outside{% endif %} banner--{{section.settings.slider_visual}} {% if section.settings.is_same_content_position_mobile %} banner--same-content-position{% endif %}"
    {% endcomment %}
    id="Slider-{{ section.id }}"
  >
    
    {%- for block in section.blocks -%}
      {% case block.type %}
        {% when 'slide' %}
          <style>
            #Slide-{{ section.id }}-{{ forloop.index }} .banner__media::after {
              opacity: {{ block.settings.image_overlay_opacity | divided_by: 100.0 }};
            }
          </style>
          <div
            class="swiper-slide ima"
            {% comment %}class="{% if forloop.index.last %}last_real_slide {% endif %} slideshow__slide grid__item grid--1-col slider__slide {% if block.settings.image_mobile %} slideshow__slide-mobile--adapt{% endif %} {% if block.settings.video %} slideshow__slide-video{% endif %} {% if block.settings.banner_link != blank %}  slideshow__slide--whole-link{% endif %}"
            {% endcomment %}
            d="Slide-{{ section.id }}-{{ forloop.index }}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.banner_link != blank -%}
              <a href="{{ block.settings.banner_link }}"
                class="banner__whole-link"
              > </a>
            {%- endif -%}

            <div class="slideshow__media banner__media media{% if block.settings.image == blank %} placeholder{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}">
              {%- if block.settings.image and block.settings.video == nil -%}
                {%- liquid
                  assign height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round
                  if section.settings.image_behavior == 'ambient'
                    assign sizes = '120vw'
                    assign widths = '1, 450, 660, 900, 1320, 1800, 2136, 2400, 3600, 7680'
                  else
                    assign sizes = '100vw'
                    assign widths = '1, 375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
                  endif
                  if block.settings.image_mobile
                    assign sizes_mobile = '(min-width: 750px) 1px, 100vw'
                    assign image_class_mobile = 'banner__media-image-mobile medium-hide large-up-hide'
                  endif
                  assign fetch_priority = 'auto'
                  if section.index == 1
                    assign fetch_priority = 'high'
                  endif
                -%}
                {%- if forloop.first and section.settings.first_block_on_page == true %}
                  {{
                    block.settings.image
                    | image_url: width: 3840
                    | image_tag: height: height, sizes: sizes, widths: widths, fetchpriority: fetch_priority
                  }}
                  {% if block.settings.image_mobile %}
                    {{
                      block.settings.image_mobile
                      | image_url: width: 3840
                      | image_tag: height: height, sizes: sizes_mobile, widths: widths, fetchpriority: fetch_priority, class: image_class_mobile
                    }}
                  {% endif %}
                {%- else -%}
                  {{
                    block.settings.image
                    | image_url: width: 3840
                    | image_tag: loading: 'lazy', height: height, sizes: sizes, widths: widths
                  }}
                  {% if block.settings.image_mobile %}
                    {{
                      block.settings.image_mobile
                      | image_url: width: 3840
                      | image_tag: height: height, sizes: sizes_mobile, widths: widths, class: image_class_mobile
                    }}
                  {% endif %}
                {%- endif -%}
              {%- elsif block.settings.video -%}
                <deferred-media
                  class="video-section__media deferred-media gradient global-media-settings{% if section.settings.full_width %} global-media-settings--full-width{% endif %}{% if fix_ratio %} media-fit-cover{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  data-media-id="{{ video_id }}"
                  {% if poster != null %}
                    style="--ratio-percent: {{ 1 | divided_by: poster.aspect_ratio | times: 100 }}%;"
                  {% endif %}
                >
                  
                    {%- if section.settings.video == null and section.settings.video_url != null -%}
                      {%- liquid
                        assign loop = ''
                        if section.settings.enable_video_looping
                          assign loop = '&loop=1&playlist=' | append: video_id
                        endif
                      -%}
                      {%- if section.settings.video_url.type == 'youtube' -%}
                        <iframe
                          src="https://www.youtube.com/embed/{{ video_id }}?enablejsapi=1&autoplay=1{{ loop }}"
                          class="js-youtube"
                          allow="autoplay; encrypted-media"
                          allowfullscreen
                          title="{{ section.settings.description | escape }}"
                        ></iframe>
                      {%- else -%}
                        <iframe
                          src="https://player.vimeo.com/video/{{ video_id }}?autoplay=1{{ loop }}"
                          class="js-vimeo"
                          allow="autoplay; encrypted-media"
                          allowfullscreen
                          title="{{ section.settings.description | escape }}"
                        ></iframe>
                      {%- endif -%}
                    {%- else -%}
                    {% assign auto_play = false %}
                    {% if forloop.index0 == 0 %}
                      {% assign auto_play = false %}
                    {% endif %}

                       {% assign video_class = "slide__video" %}
                      {{
                        block.settings.video
                        | video_tag:
                          image_size: '2200x',
                          autoplay: auto_play,
                          loop: block.settings.enable_video_looping,
                          controls: false,
                          muted: true,
                          preload: "none",
                          class: video_class
                      }}
                    {%- endif -%}
                </deferred-media>

              {%- else -%}
                {%- assign placeholder_slide = forloop.index | modulo: 2 -%}
                {%- if placeholder_slide == 1 -%}
                  {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- else -%}
                  {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              {%- endif -%}
            </div>

            <div class="slideshow__text-wrapper banner__content banner__content--{{ block.settings.box_align }} page-width{% if block.settings.show_text_box == false %} banner--desktop-transparent{% endif %}{% if settings.animations_reveal_on_scroll and forloop.index == 1 %} scroll-trigger animate--slide-in{% endif %} banner__content--{{ block.settings.mobile_content_position }}-mobile">
              
              <style>
                .banner__box--{{ block.id }} {
                  {% if block.settings.vertical_shift != 0 or block.settings.gorizontal_shift != 0 %}
                    transform: translate({{ block.settings.gorizontal_shift }}px, {{ block.settings.vertical_shift }}px) !important;
                  {% endif %}
                }
                .banner__heading--{{ block.id }} {
                  {% if block.settings.heading_font_size_mobile != 0 %}
                  font-size: {{ block.settings.heading_font_size_mobile }}px;
                  {% endif %}
                  {% if block.settings.heading_shadow %}
                  text-shadow: 0px 4px 4px rgba(0, 0, 0, 0.33);
                  {% endif %}
                }

                .banner__text--{{ block.id }} {
                  {% if block.settings.subheading_font_size_mobile > 0 %}
                  font-size: {{ block.settings.subheading_font_size_mobile }}px !important;
                  {% endif %}
                  {% if block.settings.subheading_shadow %}
                  text-shadow: 0px 4px 4px rgba(0, 0, 0, 0.25);
                  {% endif %}
                  letter-spacing: 0;
                }
                @media screen and (min-width: 550px) {
                  .banner__heading--{{ block.id }} {
                    {% if block.settings.heading_font_size_mobile != 0 %}
                    font-size: {{ block.settings.heading_font_size_mobile | times: 1.5 }}px;
                    {% endif %}
                  }
                  .banner__text--{{ block.id }} {
                    {% if block.settings.subheading_font_size_mobile > 0 %}
                    font-size: {{ block.settings.subheading_font_size_mobile | times: 1.5 }}px !important;;
                    {% endif %}
                  }
                }
                @media screen and (min-width: 750px) {
                  .banner__box--{{ block.id }} {
                    {% if block.settings.vertical_shift_desktop != 0 or block.settings.gorizontal_shift_desktop != 0 %}
                      transform: translate({{ block.settings.gorizontal_shift_desktop | times: 0.5  }}px, {{ block.settings.vertical_shift_desktop | times: 0.5 }}px) !important;
                    {% endif %}
                  }
                  .banner__heading--{{ block.id }} {
                    {% if block.settings.heading_font_size_desktop != 0 %}
                    font-size: {{ block.settings.heading_font_size_desktop | times: 0.5 }}px;
                    {% endif %}
                  }
                  .banner__text--{{ block.id }} {
                    {% if block.settings.subheading_font_size_desktop > 0 %}
                    font-size: {{ block.settings.subheading_font_size_desktop | times: 0.5 }}px !important;;
                    {% endif %}
                  }
                }
                @media screen and (min-width: 990px) {
                  .banner__box--{{ block.id }} {
                    {% if block.settings.vertical_shift_desktop != 0 or block.settings.gorizontal_shift_desktop != 0 %}
                      transform: translate({{ block.settings.gorizontal_shift_desktop  }}px, {{ block.settings.vertical_shift_desktop }}px) !important;
                    {% endif %}
                  }
                  .banner__heading--{{ block.id }} {
                    {% if block.settings.heading_font_size_desktop != 0 %}
                      {% if block.settings.heading_font_size_desktop > 80  %}
                        font-size: 80px;
                      {% else %}
                        font-size: {{ block.settings.heading_font_size_desktop }}px;
                      {% endif %}
                    {% endif %}
                  }
                  .banner__text--{{ block.id }} {
                    {% if block.settings.subheading_font_size_desktop > 0 %}
                    font-size: {{ block.settings.subheading_font_size_desktop }}px !important;;
                    {% endif %}
                  }
                }
                @media screen and (min-width: 1200px) {
                  .banner__heading--{{ block.id }} {
                    {% if block.settings.heading_font_size_desktop != 0  %}
                      font-size: {{ block.settings.heading_font_size_desktop }}px;
                    {% endif %}
                  }
                }
              </style>
            {% if block.settings.heading != blank or block.settings.subheading != blank or block.settings.button_label != blank %}
              <div class="slideshow__text banner__box banner__box--{{ block.id }} content-container content-container--full-width-mobile color-{{ block.settings.color_scheme }} gradient slideshow__text--{{ block.settings.text_alignment }} slideshow__text-mobile--{{ block.settings.text_alignment_mobile }}" >

                {%- if block.settings.heading != blank -%}
                  <h2 class="banner__heading banner__heading--{{ block.id }} inline-richtext  {{ block.settings.heading_size }} {% if block.settings.is_heading_uppercase %} uppercase {% endif %}"  style="{% if block.settings.heading_font != 'default' %}font-family: {{ block.settings.heading_font }}; font-weight: 400;{% endif %}">
                    {{ block.settings.heading }}
                  </h2>
                {%- endif -%}
                {%- if block.settings.subheading != blank -%}
                  <div class="banner__text rte banner__text--{{ block.id }}" {{ block.shopify_attributes }}>
                    <p>{{ block.settings.subheading }}</p>
                  </div>
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <div class="banner__buttons">
                    <a
                      {% if block.settings.link %}
                        href="{{ block.settings.link }}"
                      {% else %}
                        role="link" aria-disabled="true"
                      {% endif %}
                      class="button {% if block.settings.button_style_secondary %}button--secondary{% else %}button--primary{% endif %}"
                    >
                      {{- block.settings.button_label | escape -}}
                    </a>
                  </div>
                {%- endif -%}
              </div>
            {% endif %}
            </div>
          </div>

        {% when 'video_slide' %}
          <style>
            #Slide-{{ section.id }}-{{ forloop.index }} .banner__media::after {
              opacity: {{ block.settings.image_overlay_opacity | divided_by: 100.0 }};
            }
          </style>
          <div
            class="swiper-slide vide0" 
            {% comment %}class="slideshow__slide grid__item grid--1-col slider__slide {% if block.settings.image_mobile %} slideshow__slide-mobile--adapt{% endif %} {% if block.settings.video %} slideshow__slide-video{% endif %} {% if block.settings.banner_link != blank %}  slideshow__slide--whole-link{% endif %}"
            {% endcomment %}
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.banner_link != blank -%}
              <a href="{{ block.settings.banner_link }}"
                class="banner__whole-link"
              > </a>
            {%- endif -%}

            <div class="slideshow__media banner__media media{% if block.settings.image == blank %} placeholder{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}">
              {%- if block.settings.video -%}
                <deferred-media
                  class="video-section__media deferred-media gradient global-media-settings{% if section.settings.full_width %} global-media-settings--full-width{% endif %}{% if fix_ratio %} media-fit-cover{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  data-media-id="{{ video_id }}"
                  {% if poster != null %}
                    style="--ratio-percent: {{ 1 | divided_by: poster.aspect_ratio | times: 100 }}%;"
                  {% endif %}
                >
                  
                    {%- if block.settings.video == null and block.settings.video_url != null -%}
                      {%- liquid
                        assign loop = ''
                        if section.settings.enable_video_looping
                          assign loop = '&loop=1&playlist=' | append: video_id
                        endif
                      -%}
                      
                    {%- else -%}
                      {% assign video_class = "slide__video" %}
                      {% assign video_mobile_class = "medium-hide large-up-hide slide__video-mobile" %}
                      {% if block.settings.video_mobile %}
                        {% assign video_class = "slide__video small-hide" %}
                      {%- endif -%}

                      {% assign auto_play = false %}
                      {% if forloop.index0 == 0 %}
                        {% assign auto_play = false %}
                      {% endif %}

                      {{
                        block.settings.video
                        | video_tag:
                          image_size: '2200x',
                          autoplay: auto_play,
                          loop: block.settings.enable_video_looping,
                          controls: false,
                          muted: true,
                          class: video_class,
                          preload: 'none'
                      }}
                      {% if block.settings.video_mobile %}
                        {{
                          block.settings.video_mobile
                          | video_tag:
                            image_size: '1100x',
                            autoplay: auto_play,
                            loop: block.settings.enable_video_looping,
                            controls: false,
                            muted: true,
                            class: video_mobile_class,
                            preload: 'none'
                        }}
                      {%- endif -%}
                    {%- endif -%}
                </deferred-media>

              {%- else -%}
                {%- assign placeholder_slide = forloop.index | modulo: 2 -%}
                {%- if placeholder_slide == 1 -%}
                  {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- else -%}
                  {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              {%- endif -%}
            </div>

            <div class="slideshow__text-wrapper banner__content banner__content--{{ block.settings.box_align }} page-width{% if block.settings.show_text_box == false %} banner--desktop-transparent{% endif %}{% if settings.animations_reveal_on_scroll and forloop.index == 1 %} scroll-trigger animate--slide-in{% endif %} banner__content--{{ block.settings.mobile_content_position }}-mobile">
            </div>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
  
  {%- if section.blocks.size > 1 and section.settings.auto_rotate == false -%}
    
  {%- endif -%}
  <div class="swiper-pagination swiper-pagination-{{ section.id }}"></div>

  {% if section.settings.is_bottom_arrow %}
    <div class="hidden1  slideshow__bottom-arrow">
      <div id="animation" class="animation">
        <svg style="width: 100%; height: 100%; transform: translate3d(0px, 0px, 0px); content-visibility: visible;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 250 250" width="250" height="250" preserveAspectRatio="xMidYMid meet">
          <defs>
            <clipPath id="clip">
              <rect width="250" height="250" x="0" y="0" />
            </clipPath>
          </defs>
          <g clip-path="url(#clip)">
            <g transform="matrix(0.93,0,0,1,-107.5,-125)">
              <g transform="translate(250,187.58)">
                <path stroke-linecap="butt" stroke-linejoin="miter" fill="none"
                      stroke="white" stroke-width="2" stroke-miterlimit="10"
                      d="M-86.74,-38.53 C-86.74,-38.53 0,38.53 0,38.53 C0,38.53 86.74,-38.53 86.74,-38.53">
                  <animate attributeName="opacity" values="0.2;1;0.2" dur="1.5s" repeatCount="indefinite" begin="0s"/>
                </path>
              </g>

              <g transform="translate(250,250)">
                <path stroke-linecap="butt" stroke-linejoin="miter" fill="none"
                      stroke="white" stroke-width="2" stroke-miterlimit="10"
                      d="M-86.74,-38.53 C-86.74,-38.53 0,38.53 0,38.53 C0,38.53 86.74,-38.53 86.74,-38.53">
                  <animate attributeName="opacity" values="0.2;1;0.2" dur="1.5s" repeatCount="indefinite" begin="0.3s"/>
                </path>
              </g>

              <g transform="translate(250,312.42)">
                <path stroke-linecap="butt" stroke-linejoin="miter" fill="none"
                      stroke="white" stroke-width="2" stroke-miterlimit="10"
                      d="M-86.74,-38.53 C-86.74,-38.53 0,38.53 0,38.53 C0,38.53 86.74,-38.53 86.74,-38.53">
                  <animate attributeName="opacity" values="0.2;1;0.2" dur="1.5s" repeatCount="indefinite" begin="0.6s"/>
                </path>
              </g>
            </g>
          </g>
        </svg>
      </div>


    </div>
  {% endif %}
</div>

{%- if request.design_mode -%}
  <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<script>
(function(){
  document.addEventListener('DOMContentLoaded', function() {
    {% assign isAutoplay = true %} 
    {%- for block in section.blocks -%}
      {% case block.type %}
        {% when 'slide' %}
          {%- if block.settings.video -%}
            {% assign isAutoplay = false %}
          {% endif %}
        {% when 'video_slide' %}
          {% assign isAutoplay = false %}
      {% endcase %}
      {% break %}
    {% endfor %}
    let isLoop = document.querySelectorAll('#swiper-{{ section.id }} .swiper-slide');
    
    isLoop = isLoop.length > 1 ? true : false;
    new Swiper('#swiper-{{ section.id }}', {
      direction: 'horizontal',
      loop: isLoop,
      autoplay: {{ isAutoplay }},
      slidesPerView: 1,
      pagination: {
        el: '.swiper-pagination-{{ section.id }}',
        clickable: true,
      },
      on: {
        init: function() {
          let $this = this;
          let currentSlide = this.slides[this.activeIndex];
          let currentVideoMobile = currentSlide.querySelector('video.slide__video-mobile');
          let currentVideo = currentSlide.querySelector('video.slide__video');
          if ( ! currentVideoMobile ) {
            currentVideoMobile = currentVideo;
          }
          if (window.innerWidth < 749 && currentVideoMobile) {
            currentVideoMobile.play();
          } else if ( window.innerWidth > 750 && currentVideo ) {
            currentVideo.play();
          }
          this.slides.forEach(function(slide) {
            let videoMobile = slide.querySelector('video.slide__video-mobile');
            let video = slide.querySelector('video.slide__video');
            if ( ! videoMobile ) {
              videoMobile = video;
            }
            if (window.innerWidth < 749 && videoMobile) {
              // videoMobile.play();
              videoMobile.addEventListener('ended', function() {
                $this.slideNext();
              });
            } else if ( window.innerWidth > 750 && video ) {
              // video.play();
              video.addEventListener('ended', function() {
                $this.slideNext();
              });
            }
          });
        },
        slideChange: function() {
          let currentSlide = this.slides[this.activeIndex];
          this.slides.forEach(function(slide) {
            let allVideos = slide.querySelectorAll('video');
            allVideos.forEach((elem) => {
              elem.pause();
              elem.currentTime = 0;
            });
          });
          let videoMobile = currentSlide.querySelector('video.slide__video-mobile');
          let video = currentSlide.querySelector('video.slide__video');
           if ( ! videoMobile ) {
              videoMobile = video;
            }
          if (window.innerWidth < 749 && videoMobile) {
            videoMobile.play();
          } else if ( window.innerWidth > 750 && video ) {
            video.play();
          }
        }
      }
    });
    
  }, false);
})();

</script>
{% schema %}
{
  "name": "Slideshow Plus",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "first_block_on_page",
      "label": "Mark if this block first for current page",
      "default": false
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
