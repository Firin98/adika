{%- comment -%}
  Newsletter Signup — RTL-friendly subscription form styled after the reference design.
  Creates a customer record via the Shopify "customer" form. Shopify only persists the email
  natively, so first name, last name and phone are written into customer tags
  ("first_name: X, last_name: Y, phone: Z") by a small script before submit.
  Place this file at /sections/newsletter-signup.liquid
{%- endcomment -%}

{%- liquid
  assign st = section.settings
  assign uid = section.id
  assign form_id = 'nls-form-' | append: uid
-%}

{% style %}
  {{ st.heading_font | font_face: font_display: 'swap' }}
  {{ st.input_font | font_face: font_display: 'swap' }}
  {{ st.button_font | font_face: font_display: 'swap' }}

  .nls--{{ uid }} {
    background-color: {{ st.section_background }};
    padding-top: {{ st.padding_top }}px;
    padding-bottom: {{ st.padding_bottom }}px;
  }
  .nls--{{ uid }} .nls__box {
    max-width: {{ st.form_max_width }}px;
    margin-left: auto;
    margin-right: auto;
    background-color: {{ st.box_background }};
    border-radius: {{ st.box_border_radius }}px;
    padding: {{ st.box_padding }}px;
    box-sizing: border-box;
  }

  .nls--{{ uid }} .nls__heading {
    margin: 0 0 {{ st.heading_margin_bottom }}px;
    text-align: {{ st.heading_alignment }};
    font-family: {{ st.heading_font.family }}, {{ st.heading_font.fallback_families }};
    font-size: {{ st.heading_size_desktop }}px;
    font-style: {{ st.heading_style }};
    font-weight: {{ st.heading_weight }};
    {% if st.heading_uppercase %}text-transform: uppercase;{% endif %}
    letter-spacing: {{ st.heading_letter_spacing }}px;
    line-height: {{ st.heading_lh_px }}px;
    color: {{ st.heading_color }};
  }

  .nls--{{ uid }} .nls__divider {
    border: 0;
    border-top: {{ st.divider_thickness }}px solid {{ st.divider_color }};
    margin: 0 {% if st.divider_full_width %}-{{ st.box_padding }}px{% else %}0{% endif %} {{ st.divider_margin }}px !important;
  }

  .nls--{{ uid }} .nls__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ st.field_gap }}px;
  }
  .nls--{{ uid }} .nls__input {
    width: 100%;
    height: {{ st.input_height }}px;
    padding: 0 {{ st.input_padding_x }}px;
    box-sizing: border-box;
    font-family: {{ st.input_font.family }}, {{ st.input_font.fallback_families }};
    font-size: {{ st.input_size_desktop }}px;
    font-weight: {{ st.input_weight }};
    color: {{ st.input_text_color }};
    background-color: {{ st.input_background }};
    border: {{ st.input_border_width }}px solid {{ st.input_border_color }};
    border-radius: {{ st.input_border_radius }}px;
    outline: none;
    -webkit-appearance: none;
  }
  .nls--{{ uid }} .nls__input::placeholder {
    color: {{ st.input_placeholder_color }};
    opacity: 1;
  }
  .nls--{{ uid }} .nls__input:focus {
    border-color: {{ st.input_focus_border_color }};
    {% if st.input_border_width == 0 %}border-width: 1px; padding: 0 calc({{ st.input_padding_x }}px - 1px);{% endif %}
  }

  .nls--{{ uid }} .nls__consent {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-top: {{ st.consent_margin_top }}px;
    font-family: {{ st.input_font.family }}, {{ st.input_font.fallback_families }};
    font-size: {{ st.consent_size_desktop }}px;
    line-height: {{ st.consent_lh_px }}px;
    color: {{ st.consent_color }};
  }
  .nls--{{ uid }} .nls__consent input[type="checkbox"] {
    width: {{ st.checkbox_size }}px;
    height: {{ st.checkbox_size }}px;
    margin: 2px 0 0;
    flex-shrink: 0;
    accent-color: {{ st.checkbox_accent_color }};
  }
  .nls--{{ uid }} .nls__consent p { margin: 0; }

  .nls--{{ uid }} .nls__button {
    display: block;
    {% if st.button_full_width %}width: 100%;{% else %}width: auto; padding-left: 40px; padding-right: 40px; margin-left: auto; margin-right: auto;{% endif %}
    height: {{ st.button_height }}px;
    margin-top: {{ st.button_margin_top }}px;
    font-family: {{ st.button_font.family }}, {{ st.button_font.fallback_families }};
    font-size: {{ st.button_size_desktop }}px;
    font-weight: {{ st.button_weight }};
    {% if st.button_uppercase %}text-transform: uppercase;{% endif %}
    letter-spacing: {{ st.button_letter_spacing }}px;
    color: {{ st.button_text_color }};
    background-color: {{ st.button_background }};
    border: 0;
    border-radius: {{ st.button_border_radius }}px;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .nls--{{ uid }} .nls__button:hover {
    background-color: {{ st.button_hover_background }};
  }

  .nls--{{ uid }} .nls__message {
    margin-top: 14px;
    font-family: {{ st.input_font.family }}, {{ st.input_font.fallback_families }};
    font-size: {{ st.message_size }}px;
    line-height: 1.5;
  }
  .nls--{{ uid }} .nls__message--success { color: {{ st.success_color }}; }
  .nls--{{ uid }} .nls__message--error { color: {{ st.error_color }}; }
  .nls--{{ uid }} .nls__message[hidden] { display: none; }

  @media screen and (max-width: 749px) {
    .nls--{{ uid }} {
      padding-left: {{ st.mobile_side_margin }}px;
      padding-right: {{ st.mobile_side_margin }}px;
    }
    .nls--{{ uid }} .nls__box {
      padding: {{ st.box_padding_mobile }}px;
    }
    .nls--{{ uid }} .nls__heading {
      font-size: {{ st.heading_size_mobile }}px;
      line-height: {{ st.heading_lh_mobile_px }}px;
      margin-bottom: {{ st.heading_margin_bottom_mobile }}px;
    }
    {% if st.divider_full_width %}
    .nls--{{ uid }} .nls__divider {
      margin-left: -{{ st.box_padding_mobile }}px !important;
      margin-right: -{{ st.box_padding_mobile }}px !important;
      margin-left: 0 !important;
      margin-right: 0 !important;
    }
    {% endif %}
    .nls--{{ uid }} .nls__grid {
      grid-template-columns: {% if st.mobile_columns == '1' %}1fr{% else %}1fr 1fr{% endif %};
      gap: {{ st.field_gap_mobile }}px;
    }
    .nls--{{ uid }} .nls__input {
      font-size: {{ st.input_size_mobile }}px;
    }
    .nls--{{ uid }} .nls__consent {
      font-size: {{ st.consent_size_mobile }}px;
      line-height: {{ st.consent_lh_mobile_px }}px;
    }
    .nls--{{ uid }} .nls__button {
      font-size: {{ st.button_size_mobile }}px;
      margin-top: {{ st.button_margin_top_mobile }}px;
    }
  }
{% endstyle %}

<div class="nls nls--{{ uid }}">
  <div class="nls__box" dir="{{ st.text_direction }}">
    {%- if st.heading != blank -%}
      <h2 class="nls__heading">{{ st.heading | escape }}</h2>
    {%- endif -%}

    {%- if st.show_divider -%}
      <hr class="nls__divider">
    {%- endif -%}

    {% form 'customer', id: form_id %}
      <input type="hidden" name="contact[tags]" value="{{ st.static_tags | escape }}" data-nls-tags>
      <input type="hidden" name="return_to" value="{{ request.path }}">

      <div class="nls__grid">
        {%- if st.show_first_name -%}
          <input
            type="text"
            class="nls__input"
            placeholder="{{ st.ph_first_name | escape }}{% if st.require_names %} *{% endif %}"
            autocomplete="given-name"
            data-nls-field="first_name"
            {% if st.require_names %}required{% endif %}
          >
        {%- endif -%}
        {%- if st.show_last_name -%}
          <input
            type="text"
            class="nls__input"
            placeholder="{{ st.ph_last_name | escape }}{% if st.require_names %} *{% endif %}"
            autocomplete="family-name"
            data-nls-field="last_name"
            {% if st.require_names %}required{% endif %}
          >
        {%- endif -%}
        <input
          type="email"
          class="nls__input"
          name="contact[email]"
          placeholder="{{ st.ph_email | escape }} *"
          autocomplete="email"
          required
        >
        {%- if st.show_phone -%}
          <input
            type="tel"
            class="nls__input"
            placeholder="{{ st.ph_phone | escape }}{% if st.require_phone %} *{% endif %}"
            autocomplete="tel"
            data-nls-field="phone"
            {% if st.require_phone %}required{% endif %}
          >
        {%- endif -%}
      </div>

      {%- if st.show_consent -%}
        <label class="nls__consent">
          <input type="checkbox" {% if st.consent_required %}required{% endif %}>
          <span>{{ st.consent_text }}</span>
        </label>
      {%- endif -%}

      <button type="submit" class="nls__button">{{ st.button_text | escape }}</button>

      {%- if form.errors -%}
        <div class="nls__message nls__message--error">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div
        class="nls__message nls__message--success"
        data-nls-success
        {% unless form.posted_successfully %}hidden{% endunless %}
      >{{ st.success_text | escape }}</div>
    {% endform %}
  </div>
</div>

<script>
  (function () {
    var form = document.getElementById({{ form_id | json }});
    if (!form) return;

    form.addEventListener('submit', function () {
      var tagsInput = form.querySelector('[data-nls-tags]');
      if (!tagsInput) return;
      var tags = [];
      if (tagsInput.getAttribute('value')) tags.push(tagsInput.getAttribute('value'));
      form.querySelectorAll('[data-nls-field]').forEach(function (field) {
        var v = field.value.trim().replace(/,/g, ' ');
        if (v) tags.push(field.getAttribute('data-nls-field') + ': ' + v);
      });
      tagsInput.value = tags.join(', ');
    });

    if (window.location.search.indexOf('customer_posted=true') !== -1) {
      var success = form.querySelector('[data-nls-success]');
      if (success) {
        success.hidden = false;
        form.scrollIntoView({ block: 'center' });
      }
    }
  })();
</script>

