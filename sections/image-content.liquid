{%- comment -%}
  Event Split Banner — two-column event announcement section (image + RTL content).
  Place this file at /sections/event-split-banner.liquid
{%- endcomment -%}

{%- liquid
  assign st = section.settings
  assign uid = section.id

  if st.heading_rtl
    assign heading_dir = 'rtl'
  else
    assign heading_dir = 'ltr'
  endif

  if st.text_direction == 'rtl'
    case st.content_text_alignment
      when 'right'
        assign icon_justify = 'flex-start'
      when 'left'
        assign icon_justify = 'flex-end'
      else
        assign icon_justify = 'center'
    endcase
  else
    case st.content_text_alignment
      when 'right'
        assign icon_justify = 'flex-end'
      when 'left'
        assign icon_justify = 'flex-start'
      else
        assign icon_justify = 'center'
    endcase
  endif
-%}

{% style %}
  {{ st.heading_font | font_face: font_display: 'swap' }}
  {{ st.subheading_font | font_face: font_display: 'swap' }}
  {{ st.body_font | font_face: font_display: 'swap' }}
  {{ st.icon_label_font | font_face: font_display: 'swap' }}
  {{ st.price_font | font_face: font_display: 'swap' }}

  .esb--{{ uid }} {
    background-color: {{ st.section_background }};
    padding-top: {{ st.padding_top }}px;
    padding-bottom: {{ st.padding_bottom }}px;
  }
  .esb--{{ uid }} .esb__inner {
    display: flex;
    align-items: {% if st.image_full_height %}stretch{% else %}center{% endif %};
    gap: {{ st.column_gap }}px;
    {% unless st.full_width %}
      max-width: {{ st.max_width }}px;
      margin-left: auto;
      margin-right: auto;
      padding-left: 20px;
      padding-right: 20px;
    {% endunless %}
    {% if st.image_position == 'left' %}flex-direction: row-reverse;{% endif %}
  }
  .esb--{{ uid }} .esb__content {
    flex: 0 0 {{ st.content_column_width }}%;
    max-width: {{ st.content_column_width }}%;
    text-align: {{ st.content_text_alignment }};
  }
  .esb--{{ uid }} .esb__media {
    flex: 1 1 0;
    min-width: 0;
    position: relative;
  }
  .esb--{{ uid }} .esb__media img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: {{ st.image_border_radius }}px;
    {% case st.image_ratio %}
      {% when 'portrait-3-4' %}aspect-ratio: 3 / 4; object-fit: cover;
      {% when 'portrait-2-3' %}aspect-ratio: 2 / 3; object-fit: cover;
      {% when 'square' %}aspect-ratio: 1 / 1; object-fit: cover;
    {% endcase %}
    {% if st.image_full_height %}
      position: absolute;
      inset: 0;
      height: 100%;
      object-fit: cover;
      aspect-ratio: auto;
    {% endif %}
  }
  .esb--{{ uid }} .esb__media .esb__placeholder {
    width: 100%;
    height: 100%;
    background: #f4f4f4;
    border-radius: {{ st.image_border_radius }}px;
  }

  .esb--{{ uid }} .esb__heading--mobile {
    display: none;
  }

  .esb--{{ uid }} .esb__heading {
    margin: 0;
    font-family: {{ st.heading_font.family }}, {{ st.heading_font.fallback_families }};
    font-size: {{ st.heading_size_desktop }}px;
    font-style: {{ st.heading_style }};
    font-weight: {{ st.heading_weight }};
    {% if st.heading_uppercase %}text-transform: uppercase;{% endif %}
    letter-spacing: {{ st.heading_letter_spacing }}px;
    line-height: {{ st.heading_line_height }};
    color: {{ st.heading_color }};
  }

  .esb--{{ uid }} .esb__subheading {
    margin-top: {{ st.subheading_top_margin }}px;
    font-family: {{ st.subheading_font.family }}, {{ st.subheading_font.fallback_families }};
    font-size: {{ st.subheading_size }}px;
    font-weight: {{ st.subheading_weight }};
    color: {{ st.subheading_color }};
    line-height: 1.5;
  }

  .esb--{{ uid }} .esb__body {
    margin-top: {{ st.body_top_margin }}px;
    font-family: {{ st.body_font.family }}, {{ st.body_font.fallback_families }};
    font-size: {{ st.body_size }}px;
    font-weight: {{ st.body_weight }};
    line-height: {{ st.body_line_height }};
    color: {{ st.body_color }};
  }
  .esb--{{ uid }} .esb__body p { margin: 0 0 0.6em; }
  .esb--{{ uid }} .esb__body p:last-child { margin-bottom: 0; }

  .esb--{{ uid }} .esb__icon-row {
    margin-top: {{ st.icon_row_top_margin }}px;
    display: flex;
    align-items: center;
    justify-content: {{ icon_justify }};
    gap: {{ st.icon_gap }}px;
  }
  .esb--{{ uid }} .esb__icon {
    width: {{ st.icon_size }}px;
    height: {{ st.icon_size }}px;
    object-fit: contain;
    flex-shrink: 0;
    {% if st.icon_round %}border-radius: 50%;{% endif %}
    order: {% if st.icon_placement == 'before' %}0{% else %}2{% endif %};
  }
  .esb--{{ uid }} .esb__icon-label {
    order: 1;
    font-family: {{ st.icon_label_font.family }}, {{ st.icon_label_font.fallback_families }};
    font-size: {{ st.icon_label_size }}px;
    font-weight: {{ st.icon_label_weight }};
    color: {{ st.icon_label_color }};
  }

  .esb--{{ uid }} .esb__price-box {
    margin-top: {{ st.price_box_top_margin }}px;
    {% if st.price_box_width == 'full' %}
      display: block;
      width: 100%;
    {% else %}
      display: inline-block;
    {% endif %}
    background-color: {{ st.price_box_background }};
    color: {{ st.price_box_text_color }};
    border-radius: {{ st.price_box_border_radius }}px;
    padding: {{ st.price_box_padding }}px;
    font-family: {{ st.price_font.family }}, {{ st.price_font.fallback_families }};
    font-size: {{ st.price_size }}px;
    font-weight: {{ st.price_weight }};
    line-height: {{ st.price_line_height }};
    box-sizing: border-box;
  }
  .esb--{{ uid }} .esb__price-line { display: block; }
  .esb--{{ uid }} .esb__price-line--bold { font-weight: 700; }

  @media screen and (max-width: 749px) {
    .esb--{{ uid }} {
      padding-top: {{ st.padding_top_mobile }}px;
      padding-bottom: {{ st.padding_bottom_mobile }}px;
    }
    .esb--{{ uid }} .esb__inner {
      flex-direction: column;
      gap: {{ st.column_gap | divided_by: 2 | at_least: 16 }}px;
    }
    .esb--{{ uid }} .esb__content {
      flex-basis: auto;
      max-width: 100%;
      width: 100%;
      text-align: {{ st.mobile_content_alignment }};
      order: {% if st.mobile_stack_order == 'image_first' %}2{% else %}1{% endif %};
    }
    .esb--{{ uid }} .esb__media {
      width: 100%;
      order: {% if st.mobile_stack_order == 'image_first' %}1{% else %}2{% endif %};
    }
    .esb--{{ uid }} .esb__media img {
      position: static;
      height: auto;
    }
    .esb--{{ uid }} .esb__heading {
      font-size: {{ st.heading_size_mobile }}px;
    }
    .esb--{{ uid }} .esb__heading--desktop {
      display: none;
    }
    .esb--{{ uid }} .esb__heading--mobile {
      display: block;
      order: 0;
      width: 100%;
      text-align: {{ st.mobile_content_alignment }};
      text-align: center;
    }
    .esb--{{ uid }} .esb__icon-row {
      justify-content: {% if st.mobile_content_alignment == 'center' %}center{% elsif st.mobile_content_alignment == 'right' %}{% if st.text_direction == 'rtl' %}flex-start{% else %}flex-end{% endif %}{% else %}{% if st.text_direction == 'rtl' %}flex-end{% else %}flex-start{% endif %}{% endif %};
    }
  }
{% endstyle %}

<div class="esb esb--{{ uid }}">
  <div class="esb__inner">
    {%- if st.heading != blank -%}
      <h2 class="esb__heading esb__heading--mobile" dir="{{ heading_dir }}">{{ st.heading | escape | newline_to_br }}</h2>
    {%- endif -%}
    <div class="esb__content" dir="{{ st.text_direction }}">
      {%- if st.heading != blank -%}
        <h2 class="esb__heading esb__heading--desktop" dir="{{ heading_dir }}">{{ st.heading | escape | newline_to_br }}</h2>
      {%- endif -%}

      {%- if st.date_text != blank or st.subheading != blank -%}
        <div class="esb__subheading">
          {%- if st.date_text != blank -%}<div>{{ st.date_text | escape }}</div>{%- endif -%}
          {%- if st.subheading != blank -%}<div>{{ st.subheading | escape }}</div>{%- endif -%}
        </div>
      {%- endif -%}

      {%- if st.body_text != blank -%}
        <div class="esb__body">{{ st.body_text }}</div>
      {%- endif -%}

      {%- if st.icon_image != blank or st.icon_label != blank -%}
        <div class="esb__icon-row">
          {%- if st.icon_image != blank -%}
            {{ st.icon_image | image_url: width: 160 | image_tag: class: 'esb__icon', alt: st.icon_label | escape }}
          {%- endif -%}
          {%- if st.icon_label != blank -%}
            <span class="esb__icon-label">{{ st.icon_label | escape }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="esb__price-box">
          {%- for block in section.blocks -%}
            <span
              class="esb__price-line{% if block.settings.line_bold %} esb__price-line--bold{% endif %}"
              {{ block.shopify_attributes }}
            >{{ block.settings.line_text | escape }}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="esb__media">
      {%- if st.main_image != blank -%}
        {{ st.main_image | image_url: width: 1500 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1500' }}
      {%- else -%}
        <div class="esb__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
