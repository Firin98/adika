{%- comment -%}
  Rich Text Blocks — heading and paragraph content built from reorderable blocks
  with adjustable spacing between them. Supports RTL (Hebrew) content.
  Per-block overrides are passed as CSS custom properties, so desktop and mobile
  values both work from a single inline style attribute.
  Place this file at /sections/rich-text-blocks.liquid
{%- endcomment -%}

{%- liquid
  assign st = section.settings
  assign uid = section.id
-%}

{% style %}
  {{ st.heading_font | font_face: font_display: 'swap' }}
  {{ st.body_font | font_face: font_display: 'swap' }}

  .rtb--{{ uid }} {
    background-color: {{ st.section_background }};
    padding-top: {{ st.padding_top }}px;
    padding-bottom: {{ st.padding_bottom }}px;
  }
  .rtb--{{ uid }} .rtb__column {
    max-width: {{ st.content_max_width }}px;
    padding-left: 20px;
    padding-right: 20px;
    box-sizing: border-box;
    {% case st.column_position %}
      {% when 'left' %}margin-right: auto;
      {% when 'right' %}margin-left: auto;
      {% else %}margin-left: auto; margin-right: auto;
    {% endcase %}
    text-align: {{ st.text_alignment }};
  }

  .rtb--{{ uid }} .rtb__block {
    margin-top: var(--sp-above, {{ st.block_spacing }}px);
  }
  .rtb--{{ uid }} .rtb__block:first-child {
    margin-top: 0;
  }
  .rtb--{{ uid }} .rtb__block:last-child {
    margin-bottom: 0;
  }

  .rtb--{{ uid }} .rtb__heading {
    font-family: {{ st.heading_font.family }}, {{ st.heading_font.fallback_families }};
    font-size: var(--fs, {{ st.heading_size_desktop }}px);
    font-style: {{ st.heading_style }};
    font-weight: var(--fw, {{ st.heading_weight }});
    {% if st.heading_uppercase %}text-transform: uppercase;{% endif %}
    letter-spacing: {{ st.heading_letter_spacing }}px;
    line-height: var(--lh, {{ st.heading_lh_px }}px);
    color: var(--c, {{ st.heading_color }});
    margin: 0;
    margin-bottom: var(--sp-below, {{ st.heading_margin_bottom }}px);
  }

  .rtb--{{ uid }} .rtb__paragraph {
    font-family: {{ st.body_font.family }}, {{ st.body_font.fallback_families }};
    font-size: var(--fs, {{ st.body_size_desktop }}px);
    font-weight: var(--fw, {{ st.body_weight }});
    letter-spacing: {{ st.body_letter_spacing }}px;
    line-height: var(--lh, {{ st.body_lh_px }}px);
    color: var(--c, {{ st.body_color }});
    margin-bottom: var(--sp-below, {{ st.paragraph_margin_bottom }}px);
  }
  .rtb--{{ uid }} .rtb__paragraph p { margin: 0 0 {{ st.paragraph_inner_spacing }}px; }
  .rtb--{{ uid }} .rtb__paragraph p:last-child { margin-bottom: 0; }
  .rtb--{{ uid }} .rtb__paragraph a { color: inherit; }

  .rtb--{{ uid }} .rtb__divider {
    border: 0;
    border-top-width: 1px;
    border-top-style: solid;
    margin-left: 0;
    margin-right: 0;
  }

  @media screen and (max-width: 749px) {
    .rtb--{{ uid }} .rtb__column {
      text-align: {{ st.mobile_text_alignment }};
    }
    .rtb--{{ uid }} .rtb__block {
      margin-top: var(--sp-above, {{ st.block_spacing_mobile }}px);
    }
    .rtb--{{ uid }} .rtb__block:first-child {
      margin-top: 0;
    }
    .rtb--{{ uid }} .rtb__heading {
      font-size: var(--fs-m, {{ st.heading_size_mobile }}px);
      letter-spacing: {{ st.heading_letter_spacing_mobile }}px;
      line-height: var(--lh-m, {{ st.heading_lh_mobile_px }}px);
      margin-bottom: var(--sp-below, {{ st.heading_margin_bottom_mobile }}px);
    }
    .rtb--{{ uid }} .rtb__paragraph {
      font-size: var(--fs-m, {{ st.body_size_mobile }}px);
      letter-spacing: {{ st.body_letter_spacing_mobile }}px;
      line-height: var(--lh-m, {{ st.body_lh_mobile_px }}px);
      margin-bottom: var(--sp-below, {{ st.paragraph_margin_bottom_mobile }}px);
    }
    .rtb--{{ uid }} .rtb__paragraph p { margin: 0 0 {{ st.paragraph_inner_spacing_mobile }}px; }
    .rtb--{{ uid }} .rtb__paragraph p:last-child { margin-bottom: 0; }
  }
{% endstyle %}

<div class="rtb rtb--{{ uid }}">
  <div class="rtb__column" dir="{{ st.text_direction }}">
    {%- for block in section.blocks -%}
      {%- liquid
        assign inline = ''
        if block.settings.custom_spacing
          assign inline = inline | append: '--sp-above:' | append: block.settings.top_spacing | append: 'px;'
        endif
      -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          {%- liquid
            if block.settings.custom_size
              assign inline = inline | append: '--fs:' | append: block.settings.size_desktop | append: 'px;'
              assign inline = inline | append: '--fs-m:' | append: block.settings.size_mobile | append: 'px;'
            endif
            if block.settings.custom_line_height
              assign inline = inline | append: '--lh:' | append: block.settings.line_height_px | append: 'px;'
              assign inline = inline | append: '--lh-m:' | append: block.settings.line_height_mobile_px | append: 'px;'
            endif
            if block.settings.custom_color
              assign inline = inline | append: '--c:' | append: block.settings.color | append: ';'
            endif
            if block.settings.weight != 'default'
              assign inline = inline | append: '--fw:' | append: block.settings.weight | append: ';'
            endif
            if block.settings.custom_spacing_below
              assign inline = inline | append: '--sp-below:' | append: block.settings.spacing_below | append: 'px;'
            endif
          -%}
          {%- if block.settings.text != blank -%}
            <{{ block.settings.heading_tag }}
              class="rtb__block rtb__heading"
              {% if inline != '' %}style="{{ inline }}"{% endif %}
              {{ block.shopify_attributes }}
            >{{ block.settings.text | escape | newline_to_br }}</{{ block.settings.heading_tag }}>
          {%- endif -%}

        {%- when 'paragraph' -%}
          {%- liquid
            if block.settings.custom_size
              assign inline = inline | append: '--fs:' | append: block.settings.size_desktop | append: 'px;'
              assign inline = inline | append: '--fs-m:' | append: block.settings.size_mobile | append: 'px;'
            endif
            if block.settings.custom_line_height
              assign inline = inline | append: '--lh:' | append: block.settings.line_height_px | append: 'px;'
              assign inline = inline | append: '--lh-m:' | append: block.settings.line_height_mobile_px | append: 'px;'
            endif
            if block.settings.custom_color
              assign inline = inline | append: '--c:' | append: block.settings.color | append: ';'
            endif
            if block.settings.weight != 'default'
              assign inline = inline | append: '--fw:' | append: block.settings.weight | append: ';'
            endif
            if block.settings.custom_spacing_below
              assign inline = inline | append: '--sp-below:' | append: block.settings.spacing_below | append: 'px;'
            endif
          -%}
          {%- if block.settings.text != blank -%}
            <div
              class="rtb__block rtb__paragraph"
              {% if inline != '' %}style="{{ inline }}"{% endif %}
              {{ block.shopify_attributes }}
            >{{ block.settings.text }}</div>
          {%- endif -%}

        {%- when 'spacer' -%}
          <div
            class="rtb__block rtb__spacer"
            style="{{ inline }}height:{{ block.settings.height }}px;"
            {{ block.shopify_attributes }}
          ></div>

        {%- when 'divider' -%}
          <hr
            class="rtb__block rtb__divider"
            style="{{ inline }}border-top-color:{{ block.settings.color }};border-top-width:{{ block.settings.thickness }}px;width:{{ block.settings.width }}%;"
            {{ block.shopify_attributes }}
          >
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

