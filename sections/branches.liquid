{%- comment -%}
  Section: Branches (metaobject list) — v2, no map image.
  Metaobject fields: Name (single line), Address / Phone / Working time / Approaches (rich text),
  Accessability (true/false -> wheelchair icon in the card header).
  Card: header (name + accessibility icon), divider, columns of labeled fields.
  Rich text fields are normalized: metafield_tag -> wrapper strip -> raw-JSON fallback parser.
{%- endcomment -%}

{%- liquid
  assign mo_type   = section.settings.metaobject_type | strip
  assign k_name    = section.settings.key_name       | strip
  assign k_address = section.settings.key_address    | strip
  assign k_phone   = section.settings.key_phone      | strip
  assign k_hours   = section.settings.key_hours      | strip
  assign k_appr    = section.settings.key_approaches | strip
  assign k_access  = section.settings.key_access     | strip

  assign entries = shop.metaobjects[mo_type].values
  if section.settings.reverse_order and entries.size > 0
    assign entries = entries | reverse
  endif
  assign lim = section.settings.entries_limit
  if lim == 0
    assign lim = 250
  endif

  assign field_order = section.settings.field_order | replace: ' ', '' | split: ','
  assign uid = section.id
-%}

{%- style -%}
  .brn-{{ uid }}{
    --brn-bg: {{ section.settings.color_bg }};
    --brn-pt: {{ section.settings.pt }}px;
    --brn-pb: {{ section.settings.pb }}px;
    --brn-px: {{ section.settings.px }}px;
    --brn-maxw: {% if section.settings.full_width %}100%{% else %}{{ section.settings.section_width }}px{% endif %};
    --brn-gap: {{ section.settings.gap }}px;

    --brn-card-bg: {{ section.settings.card_bg }};
    --brn-card-bw: {{ section.settings.card_border_w }}px;
    --brn-card-bc: {{ section.settings.card_border_color }};
    --brn-card-radius: {{ section.settings.card_radius }}px;
    --brn-card-py: {{ section.settings.card_pad_y }}px;
    --brn-card-px: {{ section.settings.card_pad_x }}px;

    --brn-title-fs: {{ section.settings.title_size }}px;
    --brn-title-lh: {{ section.settings.title_lh }}px;
    --brn-title-ls: {{ section.settings.title_ls }}px;
    --brn-title-fw: {{ section.settings.title_weight }};
    --brn-title-color: {{ section.settings.title_color }};

    --brn-acc-size: {{ section.settings.access_size }}px;
    --brn-acc-color: {{ section.settings.access_color }};

    --brn-div-w: {{ section.settings.divider_w }}px;
    --brn-div-color: {{ section.settings.divider_color }};
    --brn-div-mt: {{ section.settings.divider_mt }}px;
    --brn-div-mb: {{ section.settings.divider_mb }}px;

    --brn-col-gap: {{ section.settings.col_gap }}px;
    --brn-label-gap: {{ section.settings.label_gap }}px;

    --brn-label-fs: {{ section.settings.label_size }}px;
    --brn-label-lh: {{ section.settings.label_lh }}px;
    --brn-label-fw: {{ section.settings.label_weight }};
    --brn-label-color: {{ section.settings.label_color }};

    --brn-val-fs: {{ section.settings.value_size }}px;
    --brn-val-lh: {{ section.settings.value_lh }}px;
    --brn-val-fw: {{ section.settings.value_weight }};
    --brn-val-color: {{ section.settings.value_color }};
    --brn-val-maxw: {% if section.settings.value_maxw == 0 %}none{% else %}{{ section.settings.value_maxw }}px{% endif %};

    --brn-icon-size: {{ section.settings.icon_size }}px;
    --brn-icon-gap: {{ section.settings.icon_gap }}px;
    --brn-icon-color: {{ section.settings.icon_color }};

    --brn-s-mb: {{ section.settings.search_mb }}px;
    --brn-s-h: {{ section.settings.search_h }}px;
    --brn-s-px: {{ section.settings.search_px }}px;
    --brn-s-gap: {{ section.settings.search_gap }}px;
    --brn-s-bw: {{ section.settings.search_border_w }}px;
    --brn-s-bc: {{ section.settings.search_border_color }};
    --brn-s-bc-focus: {{ section.settings.search_border_focus }};
    --brn-s-radius: {{ section.settings.search_radius }}px;
    --brn-s-bg: {{ section.settings.search_bg }};
    --brn-s-fs: {{ section.settings.search_size }}px;
    --brn-s-lh: {{ section.settings.search_lh }}px;
    --brn-s-ls: {{ section.settings.search_ls }}px;
    --brn-s-color: {{ section.settings.search_color }};
    --brn-s-ph: {{ section.settings.search_ph_color }};
    --brn-s-icon: {{ section.settings.search_icon_size }}px;
    --brn-s-icon-color: {{ section.settings.search_icon_color }};

    --brn-h-fs: {{ section.settings.heading_size }}px;
    --brn-h-lh: {{ section.settings.heading_lh }}px;
    --brn-h-color: {{ section.settings.heading_color }};
    --brn-h-mb: {{ section.settings.heading_mb }}px;
  }

  .brn-{{ uid }}{
    background: var(--brn-bg);
    padding: var(--brn-pt) var(--brn-px) var(--brn-pb);
  }
  .brn-{{ uid }} *{ box-sizing: border-box; }
  .brn-{{ uid }} .brn__inner{ max-width: var(--brn-maxw); margin-inline: auto; }

  .brn-{{ uid }} .brn__heading{
    margin: 0 0 var(--brn-h-mb);
    font-size: var(--brn-h-fs);
    line-height: var(--brn-h-lh);
    font-weight: {{ section.settings.heading_weight }};
    color: var(--brn-h-color);
    text-align: {{ section.settings.heading_align }};
  }

  .brn-{{ uid }} .brn__inner{ display: flex; flex-direction: column; }
  .brn-{{ uid }} .brn__heading{ order: 0; }
  .brn-{{ uid }} .brn__search{ order: {% if section.settings.search_position == 'below' %}3{% else %}1{% endif %}; {% if section.settings.search_position == 'below' %}margin-top{% else %}margin-bottom{% endif %}: var(--brn-s-mb); }
  .brn-{{ uid }} .brn__noresults{ order: 2; }
  .brn-{{ uid }} .brn__grid{ order: 2; }

  .brn-{{ uid }} .brn__search-box{
    display: flex;
    align-items: center;
    gap: var(--brn-s-gap);
    min-height: var(--brn-s-h);
    padding-inline: var(--brn-s-px);
    background: var(--brn-s-bg);
    border: var(--brn-s-bw) solid var(--brn-s-bc);
    border-radius: var(--brn-s-radius);
    {% if section.settings.search_icon_position == 'end' %}flex-direction: row-reverse;{% endif %}
  }
  .brn-{{ uid }} .brn__search-box:focus-within{ border-color: var(--brn-s-bc-focus); }

  .brn-{{ uid }} .brn__search-icon{
    flex: 0 0 auto;
    width: var(--brn-s-icon);
    height: var(--brn-s-icon);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--brn-s-icon-color);
  }
  .brn-{{ uid }} .brn__search-icon svg{ width: 100%; height: 100%; display: block; }
  .brn-{{ uid }} .brn__search-icon img{ width: 100%; height: 100%; object-fit: contain; display: block; }

  .brn-{{ uid }} .brn__search-input{
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
    outline: none;
    background: transparent;
    box-shadow: none;
    font-family: inherit;
    font-size: var(--brn-s-fs);
    line-height: var(--brn-s-lh);
    letter-spacing: var(--brn-s-ls);
    color: var(--brn-s-color);
    {% if section.settings.search_uppercase %}text-transform: uppercase;{% endif %}
    text-align: {{ section.settings.search_align }};
  }
  .brn-{{ uid }} .brn__search-input::placeholder{ color: var(--brn-s-ph); opacity: 1; }
  .brn-{{ uid }} .brn__search-input::-webkit-search-cancel-button{ -webkit-appearance: none; appearance: none; }

  .brn-{{ uid }} .brn__search-clear{
    flex: 0 0 auto;
    width: var(--brn-s-icon);
    height: var(--brn-s-icon);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--brn-s-icon-color);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .brn-{{ uid }} .brn__search-clear[hidden]{ display: none; }
  .brn-{{ uid }} .brn__search-clear svg{ width: 100%; height: 100%; display: block; }

  .brn-{{ uid }} .brn__search-status{
    margin: {{ section.settings.status_mt }}px 0 0;
    font-size: {{ section.settings.status_size }}px;
    line-height: {{ section.settings.status_lh }}px;
    color: {{ section.settings.status_color }};
  }
  .brn-{{ uid }} .brn__search-status:empty{ display: none; }

  .brn-{{ uid }} .brn__card.is-hidden{ display: none; }

  .brn-{{ uid }} .brn__noresults{
    display: none;
    padding: {{ section.settings.noresults_pad }}px;
    text-align: {{ section.settings.noresults_align }};
    font-size: {{ section.settings.noresults_size }}px;
    line-height: {{ section.settings.noresults_lh }}px;
    color: {{ section.settings.noresults_color }};
  }
  .brn-{{ uid }}.brn--empty .brn__noresults{ display: block; }

  .brn-{{ uid }} .brn__grid{ display: grid; grid-template-columns: 1fr; gap: var(--brn-gap); }

  .brn-{{ uid }} .brn__card{
    background: var(--brn-card-bg);
    border: var(--brn-card-bw) solid var(--brn-card-bc);
    border-radius: var(--brn-card-radius);
    padding: var(--brn-card-py) var(--brn-card-px);
  }

  .brn-{{ uid }} .brn__head{
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .brn-{{ uid }} .brn__title{
    margin: 0;
    font-size: var(--brn-title-fs);
    line-height: var(--brn-title-lh);
    letter-spacing: var(--brn-title-ls);
    font-weight: var(--brn-title-fw);
    color: var(--brn-title-color);
  }
  .brn-{{ uid }} .brn__access{
    flex: 0 0 auto;
    width: var(--brn-acc-size);
    height: var(--brn-acc-size);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--brn-acc-color);
  }
  .brn-{{ uid }} .brn__access img{ width: 100%; height: 100%; object-fit: contain; display: block; }
  .brn-{{ uid }} .brn__access svg{ width: 100%; height: 100%; display: block; fill: currentColor; }

  {% if section.settings.divider_w > 0 %}
  .brn-{{ uid }} .brn__divider{
    border: 0;
    border-top: var(--brn-div-w) solid var(--brn-div-color);
    margin: var(--brn-div-mt) 0 var(--brn-div-mb);
  }
  {% else %}
  .brn-{{ uid }} .brn__divider{ border: 0; margin: var(--brn-div-mt) 0 var(--brn-div-mb); }
  {% endif %}

  .brn-{{ uid }} .brn__cols{
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols }}, minmax(0, 1fr));
    gap: var(--brn-col-gap);
    align-items: start;
  }
  .brn-{{ uid }} .brn__col{
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--brn-label-gap);
    order: var(--ord, 0);
    min-width: 0;
  }

  .brn-{{ uid }} .brn__label{
    display: flex;
    align-items: center;
    gap: var(--brn-icon-gap);
    font-size: var(--brn-label-fs);
    line-height: var(--brn-label-lh);
    font-weight: var(--brn-label-fw);
    color: var(--brn-label-color);
    {% if section.settings.icon_position == 'end' %}flex-direction: row-reverse;{% endif %}
  }
  .brn-{{ uid }} .brn__icon{
    flex: 0 0 auto;
    width: var(--brn-icon-size);
    height: var(--brn-icon-size);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--brn-icon-color);
  }
  .brn-{{ uid }} .brn__icon img{ width: 100%; height: 100%; object-fit: contain; display: block; }
  .brn-{{ uid }} .brn__icon svg{ width: 100%; height: 100%; display: block; fill: currentColor; }
  .brn-{{ uid }} .brn__icon--mask{
    background-color: var(--brn-icon-color);
    -webkit-mask-size: contain; mask-size: contain;
    -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
    -webkit-mask-position: center; mask-position: center;
  }

  .brn-{{ uid }} .brn__value{
    font-size: var(--brn-val-fs);
    line-height: var(--brn-val-lh);
    font-weight: var(--brn-val-fw);
    color: var(--brn-val-color);
    max-width: var(--brn-val-maxw);
    min-width: 0;
    overflow-wrap: break-word;
  }
  .brn-{{ uid }} .brn__value p{ margin: 0; }
  .brn-{{ uid }} .brn__value p + p{ margin-top: 4px; }
  .brn-{{ uid }} .brn__value a{ color: var(--brn-val-color); text-decoration: {{ section.settings.link_underline }}; }

  {%- liquid
    if section.settings.direction == 'ltr'
      assign phone_align = 'left'
    else
      assign phone_align = 'right'
    endif
  -%}
  {% if section.settings.phone_dir != 'inherit' %}
  .brn-{{ uid }} .brn__value--phone{
    direction: {{ section.settings.phone_dir }};
    unicode-bidi: isolate;
    text-align: {{ phone_align }};
  }
  .brn-{{ uid }} .brn__value--phone a{ unicode-bidi: isolate; }
  {% endif %}

  .brn-{{ uid }} .brn__empty{
    padding: 24px;
    border: 1px dashed var(--brn-card-bc);
    text-align: center;
    color: var(--brn-val-color);
    font-size: 14px;
    line-height: 20px;
  }

  @media screen and (max-width: {{ section.settings.mobile_bp }}px){
    .brn-{{ uid }}{
      --brn-pt: {{ section.settings.pt_m }}px;
      --brn-pb: {{ section.settings.pb_m }}px;
      --brn-px: {{ section.settings.px_m }}px;
      --brn-gap: {{ section.settings.gap_m }}px;

      --brn-card-py: {{ section.settings.card_pad_y_m }}px;
      --brn-card-px: {{ section.settings.card_pad_x_m }}px;
      --brn-card-radius: {{ section.settings.card_radius_m }}px;

      --brn-title-fs: {{ section.settings.title_size_m }}px;
      --brn-title-lh: {{ section.settings.title_lh_m }}px;

      --brn-acc-size: {{ section.settings.access_size_m }}px;

      --brn-div-mt: {{ section.settings.divider_mt_m }}px;
      --brn-div-mb: {{ section.settings.divider_mb_m }}px;

      --brn-col-gap: {{ section.settings.col_gap_m }}px;
      --brn-label-gap: {{ section.settings.label_gap_m }}px;

      --brn-label-fs: {{ section.settings.label_size_m }}px;
      --brn-label-lh: {{ section.settings.label_lh_m }}px;

      --brn-val-fs: {{ section.settings.value_size_m }}px;
      --brn-val-lh: {{ section.settings.value_lh_m }}px;

      --brn-icon-size: {{ section.settings.icon_size_m }}px;
      --brn-icon-gap: {{ section.settings.icon_gap_m }}px;

      --brn-s-mb: {{ section.settings.search_mb_m }}px;
      --brn-s-h: {{ section.settings.search_h_m }}px;
      --brn-s-px: {{ section.settings.search_px_m }}px;
      --brn-s-fs: {{ section.settings.search_size_m }}px;
      --brn-s-lh: {{ section.settings.search_lh_m }}px;
      --brn-s-icon: {{ section.settings.search_icon_size_m }}px;

      --brn-h-fs: {{ section.settings.heading_size_m }}px;
      --brn-h-lh: {{ section.settings.heading_lh_m }}px;
      --brn-h-mb: {{ section.settings.heading_mb_m }}px;
    }
    .brn-{{ uid }} .brn__cols{ grid-template-columns: repeat({{ section.settings.cols_m }}, minmax(0, 1fr)); }
    .brn-{{ uid }} .brn__col{ order: var(--ord-m, 0); {% if section.settings.center_cols_m %}align-items: center; text-align: center;{% endif %} }
    {% if section.settings.center_cols_m and section.settings.phone_dir != 'inherit' %}
    .brn-{{ uid }} .brn__value--phone{ text-align: center; }
    {% endif %}
  }
{%- endstyle -%}

<div class="brn brn-{{ uid }}" id="brn-{{ uid }}" dir="{{ section.settings.direction }}">
  <div class="brn__inner">

    {%- if section.settings.heading != blank -%}
      <h2 class="brn__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.show_search -%}
      <div class="brn__search">
        <div class="brn__search-box">
          {%- if section.settings.show_search_icon -%}
            <span class="brn__search-icon" aria-hidden="true">
              {%- if section.settings.svg_search != blank -%}
                {{ section.settings.svg_search }}
              {%- elsif section.settings.icon_search != blank -%}
                {{ section.settings.icon_search | image_url: width: 96 | image_tag: loading: 'lazy', alt: '', widths: '24,48,96' }}
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" focusable="false"><path d="M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14Zm0-1.5a8.5 8.5 0 0 1 6.6 13.85l4.03 4.02a.75.75 0 1 1-1.06 1.06l-4.03-4.02A8.5 8.5 0 1 1 11 2.5Z" fill="currentColor"/></svg>
              {%- endif -%}
            </span>
          {%- endif -%}

          <input
            class="brn__search-input"
            type="search"
            data-brn-input
            {% if section.settings.search_dir != 'inherit' %}dir="{{ section.settings.search_dir }}"{% endif %}
            placeholder="{{ section.settings.search_placeholder | escape }}"
            aria-label="{{ section.settings.search_aria | default: section.settings.search_placeholder | escape }}"
            autocomplete="off">

          {%- if section.settings.show_clear -%}
            <button class="brn__search-clear" type="button" data-brn-clear hidden aria-label="{{ section.settings.clear_aria | escape }}">
              <svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true"><path d="M6.4 5.34 12 10.94l5.6-5.6 1.06 1.06-5.6 5.6 5.6 5.6-1.06 1.06-5.6-5.6-5.6 5.6-1.06-1.06 5.6-5.6-5.6-5.6L6.4 5.34Z" fill="currentColor"/></svg>
            </button>
          {%- endif -%}
        </div>

        {%- if section.settings.show_count -%}
          <p class="brn__search-status" data-brn-status aria-live="polite"></p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if entries.size > 0 -%}
      <div class="brn__noresults" data-brn-noresults>{{ section.settings.noresults_text }}</div>
      <div class="brn__grid">
        {%- for entry in entries limit: lim -%}

          {%- liquid
            assign e_name    = entry[k_name]
            assign e_address = entry[k_address]
            assign e_phone   = entry[k_phone]
            assign e_hours   = entry[k_hours]
            assign e_appr    = entry[k_appr]
            assign e_access  = entry[k_access]
            assign acc_str = e_access | append: ''
          -%}

          {%- comment -%} Normalize rich text fields to plain HTML. {%- endcomment -%}
          {%- assign field_keys = 'address,phone,hours,approaches' | split: ',' -%}
          {%- capture norm_all -%}
            {%- for fk in field_keys -%}
              {%- case fk -%}
                {%- when 'address' -%}{%- assign fv = e_address -%}
                {%- when 'phone' -%}{%- assign fv = e_phone -%}
                {%- when 'hours' -%}{%- assign fv = e_hours -%}
                {%- when 'approaches' -%}{%- assign fv = e_appr -%}
              {%- endcase -%}

              {%- assign nv = '' -%}
              {%- if fv != blank -%}
                {%- if section.settings.use_metafield_tag -%}
                  {%- capture nv -%}{{ fv | metafield_tag }}{%- endcapture -%}
                  {%- assign nv = nv | replace: '<div class="metafield-rich_text_field">', '' | replace: '<span class="metafield-single_line_text_field">', '' | replace: '<span class="metafield-multi_line_text_field">', '' | replace: '</div>', '' | replace: '<span>', '' | replace: '</span>', '' | strip -%}
                {%- endif -%}

                {%- if nv == blank or nv contains '"type":"root"' -%}
                  {%- capture nv_raw -%}{{ fv }}{%- endcapture -%}
                  {%- if nv_raw contains '"type":"root"' -%}
                    {%- assign paras = nv_raw | split: '"type":"paragraph"' -%}
                    {%- capture nv -%}
                      {%- for para in paras offset: 1 -%}
                        {%- assign vals = para | split: '"value":"' -%}
                        {%- capture ptext -%}
                          {%- for v in vals offset: 1 -%}{{ v | split: '"' | first }}{%- endfor -%}
                        {%- endcapture -%}
                        {%- assign ptext = ptext | strip -%}
                        {%- if ptext != blank -%}<p>{{ ptext }}</p>{%- endif -%}
                      {%- endfor -%}
                    {%- endcapture -%}
                  {%- else -%}
                    {%- assign nv = nv_raw | strip -%}
                  {%- endif -%}
                {%- endif -%}

                {%- unless nv contains '<p' -%}
                  {%- assign nv_s = nv | strip -%}
                  {%- if nv_s != blank -%}{%- capture nv -%}<p>{{ nv_s }}</p>{%- endcapture -%}{%- endif -%}
                {%- endunless -%}
              {%- endif -%}
              {{- nv -}}[[F]]
            {%- endfor -%}
          {%- endcapture -%}

          {%- assign norm = norm_all | split: '[[F]]' -%}
          {%- assign h_address = norm[0] -%}
          {%- assign h_phone   = norm[1] -%}
          {%- assign h_hours   = norm[2] -%}
          {%- assign h_appr    = norm[3] -%}

          {%- if section.settings.phone_link and h_phone != blank -%}
            {%- assign phone_txt = h_phone | strip_html | strip -%}
            {%- assign tel = phone_txt | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' -%}
            {%- capture h_phone -%}<p><a href="tel:{{ tel }}">{{ phone_txt }}</a></p>{%- endcapture -%}
          {%- endif -%}

          {%- capture card_hay -%}
            {{ e_name }} {{ h_address | strip_html }} {{ h_phone | strip_html }} {{ h_hours | strip_html }} {{ h_appr | strip_html }}
            {%- if acc_str contains 'true' %} {{ section.settings.access_aria }}{% endif -%}
          {%- endcapture -%}

          <div class="brn__card" data-brn-item data-search="{{ card_hay | strip_html | strip | escape }}">

            <div class="brn__head">
              {%- if section.settings.show_title and e_name != blank -%}
                <{{ section.settings.title_tag }} class="brn__title">{{ e_name | strip_html | strip }}</{{ section.settings.title_tag }}>
              {%- else -%}
                <span></span>
              {%- endif -%}
              {%- if section.settings.show_access and acc_str contains 'true' -%}
                <span class="brn__access" aria-label="{{ section.settings.access_aria | escape }}" role="img">
                  {%- if section.settings.svg_access != blank -%}
                    {{ section.settings.svg_access }}
                  {%- elsif section.settings.icon_access != blank -%}
                    {{ section.settings.icon_access | image_url: width: 96 | image_tag: loading: 'lazy', alt: '', widths: '24,48,96' }}
                  {%- endif -%}
                </span>
              {%- endif -%}
            </div>

            {%- if section.settings.show_divider -%}
              <hr class="brn__divider">
            {%- endif -%}

            <div class="brn__cols">
              {%- assign visible_i = 0 -%}
              {%- assign total_visible = 0 -%}
              {%- for fk in field_order -%}
                {%- case fk -%}
                  {%- when 'address' -%}{%- if section.settings.show_address and h_address != blank -%}{%- assign total_visible = total_visible | plus: 1 -%}{%- endif -%}
                  {%- when 'phone' -%}{%- if section.settings.show_phone and h_phone != blank -%}{%- assign total_visible = total_visible | plus: 1 -%}{%- endif -%}
                  {%- when 'hours' -%}{%- if section.settings.show_hours and h_hours != blank -%}{%- assign total_visible = total_visible | plus: 1 -%}{%- endif -%}
                  {%- when 'approaches' -%}{%- if section.settings.show_approaches and h_appr != blank -%}{%- assign total_visible = total_visible | plus: 1 -%}{%- endif -%}
                {%- endcase -%}
              {%- endfor -%}

              {%- for fk in field_order -%}
                {%- liquid
                  assign f_html = ''
                  assign f_label = ''
                  assign f_icon = nil
                  assign f_svg = ''
                  case fk
                    when 'address'
                      if section.settings.show_address
                        assign f_html = h_address
                        assign f_label = section.settings.label_address
                        assign f_icon = section.settings.icon_address
                        assign f_svg = section.settings.svg_address
                      endif
                    when 'phone'
                      if section.settings.show_phone
                        assign f_html = h_phone
                        assign f_label = section.settings.label_phone
                        assign f_icon = section.settings.icon_phone
                        assign f_svg = section.settings.svg_phone
                      endif
                    when 'hours'
                      if section.settings.show_hours
                        assign f_html = h_hours
                        assign f_label = section.settings.label_hours
                        assign f_icon = section.settings.icon_hours
                        assign f_svg = section.settings.svg_hours
                      endif
                    when 'approaches'
                      if section.settings.show_approaches
                        assign f_html = h_appr
                        assign f_label = section.settings.label_approaches
                        assign f_icon = section.settings.icon_approaches
                        assign f_svg = section.settings.svg_approaches
                      endif
                  endcase
                -%}

                {%- if f_html != blank -%}
                  {%- liquid
                    assign ord_d = visible_i
                    if section.settings.mobile_reverse
                      assign ord_m = total_visible | minus: 1 | minus: visible_i
                    else
                      assign ord_m = visible_i
                    endif
                    assign visible_i = visible_i | plus: 1
                  -%}
                  <div class="brn__col brn__col--{{ fk }}" style="--ord: {{ ord_d }}; --ord-m: {{ ord_m }};">
                    <div class="brn__label">
                      {%- if section.settings.show_icons -%}
                        {%- if f_svg != blank -%}
                          <span class="brn__icon" aria-hidden="true">{{ f_svg }}</span>
                        {%- elsif f_icon != blank -%}
                          {%- if section.settings.icon_recolor -%}
                            {%- assign icon_url = f_icon | image_url: width: 96 -%}
                            <span class="brn__icon brn__icon--mask" aria-hidden="true" style="-webkit-mask-image:url({{ icon_url }});mask-image:url({{ icon_url }});"></span>
                          {%- else -%}
                            <span class="brn__icon" aria-hidden="true">{{ f_icon | image_url: width: 96 | image_tag: loading: 'lazy', alt: '', widths: '24,48,96' }}</span>
                          {%- endif -%}
                        {%- endif -%}
                      {%- endif -%}
                      {%- if f_label != blank -%}<span>{{ f_label }}</span>{%- endif -%}
                    </div>
                    <div class="brn__value brn__value--{{ fk }}"{% if fk == 'phone' and section.settings.phone_dir != 'inherit' %} dir="{{ section.settings.phone_dir }}"{% endif %}>{{ f_html }}</div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>

          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      {%- if request.design_mode -%}
        <div class="brn__empty">
          Metaobject entries not found for type "{{ mo_type }}". Check the type handle in section settings and make sure entries are published to the Online Store.
        </div>
      {%- endif -%}
    {%- endif -%}

  </div>
</div>

{%- if section.settings.show_search -%}
<script>
  (function () {
    var root = document.getElementById('brn-{{ uid }}');
    if (!root || root.dataset.brnInit === '1') return;
    root.dataset.brnInit = '1';

    var input = root.querySelector('[data-brn-input]');
    if (!input) return;

    var cards = Array.prototype.slice.call(root.querySelectorAll('[data-brn-item]'));
    var statusEl = root.querySelector('[data-brn-status]');
    var clearBtn = root.querySelector('[data-brn-clear]');

    var delay = {{ section.settings.search_delay }};
    var minChars = {{ section.settings.search_min_chars }};
    var mode = '{{ section.settings.search_trigger }}';
    var tpl = {{ section.settings.status_template | json }};
    var timer = null;

    var reStrip;
    try { reStrip = new RegExp('[^\\p{L}\\p{N}]+', 'gu'); }
    catch (e) { reStrip = /[^a-z0-9֐-׿]+/g; }

    function norm(v) {
      return (v == null ? '' : String(v)).toLowerCase().replace(/\s+/g, ' ').trim();
    }
    function alnum(v) {
      return norm(v).replace(reStrip, '');
    }

    var data = cards.map(function (el) {
      var raw = el.getAttribute('data-search') || '';
      return { el: el, n: norm(raw), a: alnum(raw) };
    });

    function apply() {
      var q = norm(input.value);
      var qa = alnum(input.value);
      var visible = 0;
      var filtering = q.length >= minChars;

      data.forEach(function (d) {
        var hit = true;
        if (filtering) {
          hit = d.n.indexOf(q) !== -1 || (qa.length > 0 && d.a.indexOf(qa) !== -1);
        }
        d.el.classList.toggle('is-hidden', !hit);
        if (hit) visible++;
      });

      root.classList.toggle('brn--empty', filtering && visible === 0);

      if (statusEl) {
        statusEl.textContent = filtering
          ? String(tpl).replace('[count]', visible).replace('[total]', data.length)
          : '';
      }
      if (clearBtn) clearBtn.hidden = input.value.length === 0;
    }

    function schedule() {
      if (clearBtn) clearBtn.hidden = input.value.length === 0;
      clearTimeout(timer);
      timer = setTimeout(apply, delay);
    }

    if (mode === 'submit') {
      input.addEventListener('change', apply);
      input.addEventListener('blur', apply);
    } else {
      input.addEventListener('input', schedule);
    }

    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { e.preventDefault(); clearTimeout(timer); apply(); }
      if (e.key === 'Escape') { input.value = ''; clearTimeout(timer); apply(); }
    });

    if (clearBtn) {
      clearBtn.addEventListener('click', function () {
        input.value = '';
        clearTimeout(timer);
        apply();
        input.focus();
      });
    }
  })();
</script>
{%- endif -%}

