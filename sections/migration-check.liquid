{% comment %}
  Migration check - a temporary section for eyeballing the "1 product = 1 colour"
  split. Every block shows the old product on one row and the products it became
  on the next, all drawn with the normal card-product snippet.

  The handle map is baked in (snippets/migration-check-data.liquid), so the
  section works with no configuration. Because Liquid only allows 20 unique
  handles per page through all_products, the groups are paged automatically:
  the section fills a page up to that budget and prints "page X of Y".
  Groups with problems are listed first.

  Delete this section and its three files once the migration is verified.
{% endcomment %}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'migration-check.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign lookup_budget = 20

  capture raw_map
    render 'migration-check-data'
  endcapture
  assign map_body = raw_map | strip
  assign all_groups = map_body | split: '|'

  # manual override: a list of old handles typed into the section settings
  assign manual = false
  if section.settings.handles != blank
    assign manual = true
    assign manual_lines = section.settings.handles | newline_to_br | split: '<br />'
  endif

  assign only_problems = false
  if section.settings.filter == 'problems'
    assign only_problems = true
  endif
-%}

<div class="migration-check page-width section-{{ section.id }}-padding" dir="rtl">
  <h2 class="migration-check__title">{{ section.settings.heading }}</h2>

  {%- if manual -%}
    {%- liquid
      assign used = 0
      assign skipped = 0
    -%}
    {%- for raw_handle in manual_lines -%}
      {%- liquid
        assign old_handle = raw_handle | strip_newlines | strip
        if old_handle == ''
          continue
        endif
        assign kids_csv = ''
        for entry in all_groups
          assign bits = entry | split: '~'
          if bits[0] == old_handle
            assign kids_csv = bits[2]
            break
          endif
        endfor
        assign kids = kids_csv | split: ','
        assign needed = kids.size | plus: 1
        # filters are not allowed inside an if condition, so compute first
        assign would_be = used | plus: needed
      -%}
      {%- if would_be > lookup_budget -%}
        {%- assign skipped = skipped | plus: 1 -%}
        {%- continue -%}
      {%- endif -%}
      {%- assign used = used | plus: needed -%}
      {%- render 'migration-check-group',
        old_handle: old_handle,
        kids: kids,
        flag: 'ok',
        section: section
      -%}
    {%- endfor -%}
    {%- if skipped > 0 -%}
      <p class="migration-check__note">
        {{ skipped }} групп(ы) не показано: Liquid отдаёт максимум {{ lookup_budget }} товаров на страницу.
        Уберите лишние handle из настроек.
      </p>
    {%- endif -%}

  {%- else -%}
    {%- liquid
      # assign each group to a page, filling every page up to the lookup budget
      assign page_now = 1
      assign used = 0
      assign total_pages = 1
      assign shown = 0
      assign matched = 0
      assign requested = section.settings.page
    -%}
    {%- for entry in all_groups -%}
      {%- liquid
        assign bits = entry | split: '~'
        assign old_handle = bits[0]
        assign flag = bits[1]
        if only_problems and flag == 'ok'
          continue
        endif
        assign matched = matched | plus: 1
        assign kids = bits[2] | split: ','
        assign needed = kids.size | plus: 1

        assign after = used | plus: needed
        if after > lookup_budget
          assign page_now = page_now | plus: 1
          assign used = needed
        else
          assign used = after
        endif
        assign total_pages = page_now
      -%}
      {%- if page_now == requested -%}
        {%- assign shown = shown | plus: 1 -%}
        {%- render 'migration-check-group',
          old_handle: old_handle,
          kids: kids,
          flag: flag,
          section: section
        -%}
      {%- endif -%}
    {%- endfor -%}

    <p class="migration-check__note">
      Страница <strong>{{ requested }}</strong> из <strong>{{ total_pages }}</strong> ·
      групп на странице: {{ shown }} · всего групп в выборке: {{ matched }}.
      {%- if requested > total_pages %} Такой страницы нет — уменьшите номер в настройках секции.{% endif %}
      {%- unless only_problems %} Группы с проблемами идут первыми.{% endunless %}
    </p>
  {%- endif -%}
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Migration check",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Проверка миграции: было → стало" },
    {
      "type": "select", "id": "filter", "label": "Which groups",
      "options": [
        { "value": "problems", "label": "Only groups with problems" },
        { "value": "all", "label": "All groups" }
      ],
      "default": "problems"
    },
    { "type": "range", "id": "page", "min": 1, "max": 20, "step": 1, "label": "Page", "default": 1,
      "info": "Liquid allows only 20 products per page, so the groups are paged. The page number of the last page is printed under the results." },
    {
      "type": "textarea", "id": "handles", "label": "Or check these old handles",
      "info": "One per line. Overrides the two settings above."
    },
    { "type": "header", "content": "Card display" },
    {
      "type": "select", "id": "image_ratio", "label": "Image ratio",
      "options": [
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" },
        { "value": "adapt", "label": "Adapt" }
      ],
      "default": "portrait"
    },
    { "type": "checkbox", "id": "show_badges", "label": "Show badges", "default": true },
    { "type": "checkbox", "id": "show_wishlist", "label": "Show wishlist", "default": false },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 40 }
  ],
  "presets": [{ "name": "Migration check" }]
}
{% endschema %}
